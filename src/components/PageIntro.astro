---
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  label?: string;
  title: string;
  lede?: string;
  crumbs: { label: string; href?: string }[];
}

const { label, title, lede, crumbs } = Astro.props;
---

<section class="page-intro">
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
    <div class="page-intro__body">
      <div class="page-intro__title">
        {label && <p class="label">{label}</p>}
        <h1>{title}</h1>
      </div>
      {
        (lede || Astro.slots.has('default')) && (
          <div class="page-intro__lede">
            {lede && <p class="lead">{lede}</p>}
            <slot />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .page-intro {
    padding-block: var(--s-6) var(--s-8);
    border-bottom: 1px solid var(--rule);
  }
  .page-intro__body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--s-5);
    margin-top: var(--s-8);
    align-items: end;
  }
  .page-intro__title {
    grid-column: 1 / span 7;
    display: grid;
    gap: var(--s-4);
  }
  .page-intro__lede {
    grid-column: 8 / span 5;
    display: grid;
    gap: var(--s-4);
  }
  @media (max-width: 899px) {
    .page-intro__body {
      margin-top: var(--s-6);
    }
    .page-intro__title,
    .page-intro__lede {
      grid-column: 1 / -1;
    }
  }
</style>
