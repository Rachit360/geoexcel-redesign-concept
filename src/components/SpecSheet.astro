---
import type { Category, Product } from '../data/catalogue';

interface Props {
  product: Product;
  category: Category;
  headingLevel?: 'h2' | 'h3';
  showTitle?: boolean;
}

const { product, category, headingLevel = 'h2', showTitle = false } = Astro.props;
const H = headingLevel;

const rows = [
  ...(product.origin ? [{ label: 'Origin', value: product.origin }] : []),
  ...product.specs,
  ...(category.common ?? []),
  ...(product.packing?.sizes ? [{ label: 'Pack sizes', value: product.packing.sizes }] : []),
  ...(product.packing?.types ? [{ label: 'Packing', value: product.packing.types }] : []),
];
---

<article class="sheet" aria-labelledby={`sheet-${product.slug}`}>
  <header class="sheet__head">
    <span class="mono">Product sheet</span>
    <span class="sheet__cat">
      <span class="marker" data-marker={category.marker}></span>
      <span class="mono">{category.number}</span>
      {category.shortName}
    </span>
  </header>

  <H id={`sheet-${product.slug}`} class:list={['sheet__title', { 'visually-hidden': !showTitle }]}>
    {showTitle ? product.name : `Specification: ${product.name}`}
  </H>
  {showTitle && <p class="sheet__kind">{product.kind}</p>}

  <dl class="sheet__rows">
    {
      rows.map((r) => (
        <div class="sheet__row">
          <dt>{r.label}</dt>
          <dd class="mono">{r.value}</dd>
        </div>
      ))
    }
    {
      product.hs && (
        <div class="sheet__row sheet__row--hs">
          <dt>
            HS code <span class="sheet__hint">(international)</span>
          </dt>
          <dd class="mono">{product.hs}</dd>
        </div>
      )
    }
  </dl>

  <p class="sheet__note">
    Typical values as published by Geo Excel. The specification for each order is agreed in the quotation; the national
    tariff line is confirmed on the commercial invoice.
  </p>
</article>

<style>
  .sheet {
    border: 3px solid var(--ink);
    background: var(--bone);
  }

  .sheet__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    padding: 0.6rem 1rem;
    background: var(--ink);
    color: var(--bone);
    font: 800 1.0625rem/1 var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .sheet__head .mono {
    font-weight: 800;
  }

  .sheet__cat {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sheet__title {
    margin: var(--s-5) 1rem 0;
    font-family: var(--font-stencil);
    font-size: var(--step-h3);
  }

  .sheet__kind {
    margin: var(--s-2) 1rem 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .sheet__rows {
    padding: 0 1rem;
  }

  .sheet__row {
    display: grid;
    grid-template-columns: minmax(9rem, 2fr) 3fr;
    gap: var(--s-4);
    align-items: baseline;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .sheet__row:last-child {
    border-bottom: 0;
  }

  .sheet__row dt {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }

  .sheet__row dd {
    font-family: var(--font-display);
    font-size: 1.3125rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .sheet__row--hs dd {
    color: var(--red);
  }

  .sheet__hint {
    font-size: 0.75rem;
    font-weight: 500;
  }

  .sheet__note {
    padding: 0.75rem 1rem;
    border-top: 3px solid var(--ink);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 479px) {
    .sheet__row {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
