---
import { productUrl } from '../lib/paths';
import type { Category, Product } from '../data/catalogue';

interface Props {
  product: Product;
  category: Category;
  variant?: 'primary' | 'secondary' | 'compact';
}

const { product, category, variant = 'secondary' } = Astro.props;
const cls =
  variant === 'primary' ? 'btn' : variant === 'compact' ? 'btn btn--secondary btn--small' : 'btn btn--secondary';
---

<button
  type="button"
  class:list={[cls, 'add-to-quote']}
  data-quote-add
  data-id={`${category.slug}/${product.slug}`}
  data-name={product.name}
  data-category-name={category.shortName}
  data-number={category.number}
  data-href={productUrl(category.slug, product.slug)}
  aria-pressed="false"
>
  <span class="add-to-quote__icon" aria-hidden="true"></span>
  <span data-quote-label>Add to quote list</span>
  <span class="visually-hidden">: {product.name}</span>
</button>

<style>
  .add-to-quote__icon {
    position: relative;
    width: 0.75rem;
    height: 0.75rem;
    flex: none;
  }
  .add-to-quote__icon::before,
  .add-to-quote__icon::after {
    content: '';
    position: absolute;
    background: currentColor;
    transition: transform 200ms var(--ease);
  }
  .add-to-quote__icon::before {
    left: 0;
    right: 0;
    top: calc(50% - 0.75px);
    height: 1.5px;
  }
  .add-to-quote__icon::after {
    top: 0;
    bottom: 0;
    left: calc(50% - 0.75px);
    width: 1.5px;
  }
  /* Added state: the plus becomes a tick */
  .add-to-quote[aria-pressed='true'] .add-to-quote__icon::before {
    left: 0;
    right: auto;
    top: 55%;
    width: 0.4rem;
    transform: rotate(45deg);
  }
  .add-to-quote[aria-pressed='true'] .add-to-quote__icon::after {
    top: -5%;
    bottom: 10%;
    left: 60%;
    transform: rotate(40deg);
  }
  .add-to-quote[aria-pressed='true'] {
    border-color: var(--ink);
  }
</style>
