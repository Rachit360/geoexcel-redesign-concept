---
import Logo from './Logo.astro';
import { enquiryHref } from '../lib/enquiry';
import { url } from '../lib/paths';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const onProducts = Astro.url.pathname.startsWith(`${base}/products`);

const links = [
  { href: url('/products/'), label: 'Products', current: onProducts },
  { href: url('/#about'), label: 'About', current: false },
  { href: url('/#process'), label: 'How to trade', current: false },
  { href: url('/#contact'), label: 'Contact', current: false },
];
---

<header class="header">
  <div class="wrap header__inner">
    <a class="header__brand" href={url('/')} aria-label="Geo Excel, home"><Logo /></a>

    <nav class="nav" aria-label="Main">
      <ul role="list" class="nav__list" data-menu>
        {
          links.map((l) => (
            <li>
              <a class="nav__link" href={l.href} aria-current={l.current ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
        <li class="nav__cta">
          <a class="btn" href={enquiryHref()}>Send an enquiry <span class="btn__arrow" aria-hidden="true">→</span></a>
        </li>
      </ul>
    </nav>

    <a class="btn btn--small header__enquire" href={enquiryHref()}>Enquire</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-label="Menu" data-menu-toggle>
      <span aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--cream) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    height: var(--header-h);
  }

  .header__brand {
    display: inline-flex;
    margin-right: auto;
    text-decoration: none;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.4vw, 2.25rem);
  }

  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--forest);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.5rem;
    height: 2px;
    border-radius: 2px;
    background: var(--orange);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms var(--ease);
  }

  .nav__link:hover::after,
  .nav__link[aria-current]::after {
    transform: scaleX(1);
  }

  .header__enquire,
  .menu-btn {
    display: none;
  }

  .menu-btn {
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: var(--forest);
    cursor: pointer;
  }

  .menu-btn span,
  .menu-btn span::before {
    display: block;
    width: 1.1rem;
    height: 2px;
    background: var(--cream);
    transition: transform 200ms var(--ease);
  }

  .menu-btn span {
    position: relative;
    box-shadow: 0 -6px 0 var(--cream);
  }

  .menu-btn[aria-expanded='true'] span {
    box-shadow: none;
    transform: rotate(45deg);
  }

  .menu-btn span::before {
    content: '';
    position: absolute;
    top: 6px;
  }

  .menu-btn[aria-expanded='true'] span::before {
    top: 0;
    transform: rotate(-90deg);
  }

  /* mobile: nav turns into a full-screen panel under the header */
  @media (max-width: 899px) {
    .header__enquire,
    .menu-btn {
      display: inline-flex;
    }
    .menu-btn {
      display: grid;
    }
    .nav__list {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: calc(100dvh - var(--header-h));
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--s-5) var(--margin);
      background: var(--cream);
      overflow-y: auto;
    }
    .nav__list[data-open] {
      display: flex;
    }
    .nav__link {
      width: 100%;
      min-height: 3.75rem;
      border-bottom: 1px solid var(--line);
      font-family: var(--font-display);
      font-size: 2.25rem;
      font-weight: 400;
      text-transform: uppercase;
    }
    .nav__link::after {
      display: none;
    }
    .nav__cta {
      margin-top: var(--s-6);
    }
    .nav__cta .btn {
      width: 100%;
    }
  }

  @media (min-width: 900px) {
    .nav__cta {
      margin-left: var(--s-3);
    }
  }
</style>
