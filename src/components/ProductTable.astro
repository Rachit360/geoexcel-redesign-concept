---
import { Picture } from 'astro:assets';
import AddToQuote from './AddToQuote.astro';
import type { Category } from '../data/catalogue';
import { productUrl } from '../lib/paths';
import { productImage } from '../lib/images';

interface Props {
  category: Category;
  caption: string;
}
const { category, caption } = Astro.props;
---

<div class="ptable-wrap">
  <table class="ptable">
    <caption class="visually-hidden">{caption}</caption>
    <thead>
      <tr>
        <th scope="col"><span class="visually-hidden">Image</span></th>
        <th scope="col">Product</th>
        <th scope="col">Origin</th>
        <th scope="col">Key parameters</th>
        <th scope="col">Pack sizes</th>
        <th scope="col">HS</th>
        <th scope="col"><span class="visually-hidden">Quote list</span></th>
      </tr>
    </thead>
    <tbody>
      {
        category.products.map((p) => (
          <tr data-search={`${p.name} ${p.kind} ${p.origin ?? ''}`.toLowerCase()}>
            <td class="ptable__thumb">
              <a href={productUrl(category.slug, p.slug)} tabindex="-1" aria-hidden="true">
                <span class="ratio ratio--1x1">
                  <Picture src={productImage(p.image)} formats={['avif', 'webp']} widths={[120, 240]} sizes="80px" alt="" />
                </span>
              </a>
            </td>
            <th scope="row" class="ptable__name">
              <a href={productUrl(category.slug, p.slug)}>{p.name}</a>
              <span>{p.kind}</span>
            </th>
            <td data-label="Origin">{p.origin ?? '—'}</td>
            <td data-label="Key parameters">
              <span class="ptable__params">
                {p.specs.slice(0, 2).map((s) => (
                  <span>
                    <span class="muted">{s.label}</span> <span class="mono">{s.value}</span>
                  </span>
                ))}
              </span>
            </td>
            <td data-label="Pack sizes" class="mono">{p.packing?.sizes ?? '—'}</td>
            <td data-label="HS" class="mono">{p.hs ?? '—'}</td>
            <td class="ptable__action">
              <AddToQuote product={p} category={category} variant="compact" />
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .ptable {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    font-size: 0.9375rem;
  }

  .ptable thead th {
    padding: 0.75rem 0.75rem 0.75rem 0;
    border-bottom: 1px solid var(--ink);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: left;
    color: var(--muted);
  }

  .ptable tbody tr {
    border-bottom: 1px solid var(--rule);
    transition: background-color 200ms var(--ease);
  }

  .ptable tbody tr:last-child {
    border-bottom: 0;
  }

  .ptable tbody tr:hover {
    background: var(--paper-deep);
  }

  .ptable td,
  .ptable tbody th {
    padding: 1rem 0.75rem 1rem 0;
    vertical-align: top;
    text-align: left;
    font-weight: 400;
  }

  .ptable__thumb {
    width: 5.5rem;
  }

  .ptable__thumb .ratio {
    display: block;
    width: 4.5rem;
  }

  .ptable__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ptable__name {
    min-width: 12rem;
  }

  .ptable__name a {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.3125rem;
    line-height: 1.2;
    color: var(--ink);
    text-decoration: none;
  }

  .ptable__name a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .ptable__name > span {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .ptable__params {
    display: grid;
    gap: 0.2rem;
    font-size: 0.875rem;
  }

  .ptable__params .mono {
    color: var(--ink);
  }

  .ptable__action {
    text-align: right !important;
    white-space: nowrap;
    padding-right: 0 !important;
  }

  .ptable tr[hidden] {
    display: none;
  }

  /* Stacked rows on small screens: same table, restyled. */
  @media (max-width: 899px) {
    .ptable thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .ptable,
    .ptable tbody,
    .ptable tr,
    .ptable td,
    .ptable tbody th {
      display: block;
    }
    .ptable tbody tr {
      display: grid;
      grid-template-columns: 4.5rem minmax(0, 1fr);
      column-gap: var(--s-4);
      padding: var(--s-5) 0;
    }
    .ptable td,
    .ptable tbody th {
      padding: 0;
      grid-column: 2;
    }
    .ptable__thumb {
      grid-column: 1 !important;
      grid-row: 1 / span 6;
      width: auto;
    }
    .ptable td[data-label] {
      display: grid;
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: var(--s-3);
      margin-top: 0.4rem;
      font-size: 0.875rem;
    }
    .ptable td[data-label]::before {
      content: attr(data-label);
      color: var(--muted);
      font-family: var(--font-sans);
    }
    .ptable__action {
      margin-top: var(--s-4);
      text-align: left !important;
    }
  }
</style>
