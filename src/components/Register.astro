---
import { publicRegister, formatDate, statusOf } from '../data/registrations';

interface Props {
  caption?: string;
  detailed?: boolean;
}
const { caption = 'Registrations held by Geo Excel', detailed = false } = Astro.props;
---

<div class="register-wrap">
  <table class="register">
    <caption class="visually-hidden">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Document</th>
        <th scope="col">Issued by</th>
        <th scope="col">Number</th>
        {detailed && <th scope="col">Scope</th>}
        <th scope="col">Issued</th>
        <th scope="col">Valid until</th>
        <th scope="col">Status</th>
      </tr>
    </thead>
    <tbody>
      {
        publicRegister.map((r) => {
          const s = statusOf(r);
          return (
            <tr>
              <th scope="row">
                <span class="register__doc">{r.document}</span>
              </th>
              <td data-label="Issued by">
                <span>
                  <span class="register__issuer">{r.issuerShort}</span>
                  <span class="register__issuer-full">{r.issuer}</span>
                </span>
              </td>
              <td data-label="Number" class="mono">
                {r.number}
              </td>
              {detailed && <td data-label="Scope">{r.scope}</td>}
              <td data-label="Issued" class="mono">
                {formatDate(r.issued)}
              </td>
              <td data-label="Valid until" class="mono">
                {r.validUntil ? formatDate(r.validUntil) : 'No expiry'}
              </td>
              <td data-label="Status">
                <span class:list={['status', { 'status--ok': s.current }]}>{s.label}</span>
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

<style>
  .register {
    width: 100%;
    border-collapse: collapse;
    border: 3px solid var(--ink);
    background: var(--bone);
    font-size: 0.9375rem;
  }

  .register thead th {
    padding: 0.7rem 1rem;
    background: var(--ink);
    color: var(--bone);
    font: 800 0.9375rem/1 var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: left;
    white-space: nowrap;
  }

  .register tbody tr + tr {
    border-top: 1px solid var(--rule);
  }

  .register td,
  .register tbody th {
    padding: 1.1rem 1rem;
    vertical-align: top;
    text-align: left;
    font-weight: 400;
  }

  .register__doc {
    font-family: var(--font-display);
    font-size: 1.3125rem;
    font-weight: 750;
    line-height: 1.1;
    color: var(--ink);
  }

  .register__issuer {
    display: block;
    font-family: var(--font-stencil);
    font-size: 1.75rem;
    font-weight: 850;
    line-height: 1;
    color: var(--ink);
  }

  .register__issuer-full {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--muted);
    max-width: 17rem;
  }

  .register .mono {
    font-size: 1.125rem;
    color: var(--ink);
    white-space: nowrap;
  }

  /* Status as an inspection stamp */
  .status {
    display: inline-block;
    padding: 0.3rem 0.6rem 0.2rem;
    border: 3px solid currentColor;
    font: 850 1.0625rem/1 var(--font-stencil);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--alert);
    transform: rotate(-3deg);
  }

  .status--ok {
    color: var(--ok);
  }

  @media (max-width: 899px) {
    .register thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .register,
    .register tbody,
    .register tr,
    .register td,
    .register tbody th {
      display: block;
    }
    .register tbody tr {
      padding: var(--s-5) var(--s-4);
    }
    .register td,
    .register tbody th {
      padding: 0;
    }
    .register td[data-label] {
      display: grid;
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: var(--s-3);
      margin-top: 0.6rem;
      font-size: 0.875rem;
    }
    .register td[data-label]::before {
      content: attr(data-label);
      color: var(--muted);
      font-weight: 600;
    }
    .register .mono {
      white-space: normal;
      word-break: break-word;
    }
  }
</style>
