---
import { Picture } from 'astro:assets';
import { publicRegister, statusOf, formatDate } from '../../data/registrations';
import { certImage } from '../../lib/images';
---

<section class="section wrap" id="certifications" aria-labelledby="cert-title">
  <div class="cert__head">
    <div class="intro">
      <p class="eyebrow">Registrations</p>
      <h2 id="cert-title">Registered to <span class="hl">trade internationally.</span></h2>
    </div>
    <p class="lead">
      The registrations Geo Excel publishes, with numbers and dates. Status is worked out from each document’s validity
      date when the site is built.
    </p>
  </div>

  <ul class="certs" role="list">
    {
      publicRegister.map((r) => {
        const status = statusOf(r);
        return (
          <li class="cert" data-reveal>
            <div class="cert__img">
              <Picture src={certImage(r.id)} formats={['avif', 'webp']} widths={[320, 560]} sizes="(min-width: 900px) 28vw, 100vw" alt={`${r.document} issued to Geo Excel`} />
            </div>
            <div class="cert__body">
              <p class="cert__issuer">{r.issuerShort}</p>
              <h3 class="cert__doc">{r.document}</h3>
              <dl>
                <div>
                  <dt>Number</dt>
                  <dd>{r.number}</dd>
                </div>
                <div>
                  <dt>Issued</dt>
                  <dd>{formatDate(r.issued)}</dd>
                </div>
                <div>
                  <dt>Valid until</dt>
                  <dd>{r.validUntil ? formatDate(r.validUntil) : 'No expiry'}</dd>
                </div>
              </dl>
              <p class:list={['cert__status', { 'is-current': status.current }]}>{status.label}</p>
            </div>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .cert__head {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--s-6);
    align-items: end;
    margin-bottom: var(--s-7);
  }

  .cert__head .intro {
    margin-bottom: 0;
  }

  .certs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .cert {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border-radius: var(--r-card);
    background: var(--white);
  }

  .cert__img {
    margin: 0.5rem 0.5rem 0;
    height: 12rem;
    overflow: hidden;
    border-radius: var(--r-inner);
    background: var(--cream-2);
  }

  .cert__img :global(picture) {
    height: 100%;
  }

  .cert__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .cert__body {
    display: grid;
    align-content: start;
    gap: var(--s-3);
    padding: var(--s-5);
  }

  .cert__issuer {
    font-family: var(--font-display);
    font-size: 2.5rem;
    line-height: 1;
    color: var(--forest);
  }

  .cert__doc {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
    text-transform: none;
    color: var(--text);
  }

  .cert dl {
    display: grid;
    gap: 0.4rem;
    font-size: 0.875rem;
  }

  .cert dl div {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
  }

  .cert dt {
    color: var(--muted);
  }

  .cert dd {
    font-weight: 700;
    color: var(--forest);
    text-align: right;
    word-break: break-word;
  }

  .cert__status {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--r-pill);
    background: #f6dcd3;
    color: #8e2c12;
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .cert__status.is-current {
    background: #d7ebc8;
    color: #1f5132;
  }

  .cert__status::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
  }

  @media (max-width: 899px) {
    .cert__head {
      grid-template-columns: 1fr;
    }
    .certs {
      grid-template-columns: 1fr;
    }
  }
</style>
