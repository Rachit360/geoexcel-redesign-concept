---
import { productCount, categories } from '../../data/catalogue';

const stats = [
  { value: '1980s', label: 'Family roots in farming rice, sugarcane and sesame' },
  { value: String(productCount), label: 'Products across rice, spices, frozen foods, oils and ghee' },
  { value: String(categories.length), label: 'Principal product categories' },
  { value: '2023', label: 'Registered with APEDA as a merchant exporter' },
];
---

<section class="stats wrap" aria-label="Geo Excel at a glance">
  <ul role="list">
    {
      stats.map((s) => (
        <li data-reveal>
          <span class="stats__value">{s.value}</span>
          <span class="stats__label">{s.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .stats ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-3);
    padding-block: var(--s-6);
  }

  .stats li {
    display: grid;
    gap: 0.35rem;
    padding: var(--s-5);
    border-radius: var(--r-card);
    background: var(--cream-2);
  }

  .stats__value {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 2rem + 2vw, 4rem);
    line-height: 1;
    color: var(--forest);
  }

  .stats li:first-child .stats__value {
    color: var(--orange-ink);
  }

  .stats__label {
    font-size: 0.875rem;
    color: var(--muted);
  }

  @media (max-width: 899px) {
    .stats ul {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
