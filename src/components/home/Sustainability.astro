---
import { Picture } from 'astro:assets';
import { sdg } from '../../data/company';
import { photo } from '../../lib/images';
---

<section class="sdg" id="sustainability" aria-labelledby="sdg-title">
  <div class="wrap sdg__grid">
    <div class="sdg__text">
      <p class="eyebrow">Sustainability</p>
      <h2 id="sdg-title">Growing <span class="hl">responsibly.</span></h2>
      <p class="lead">{sdg.statement}</p>
      <ul role="list" class="sdg__list">
        {sdg.approach.map((a) => <li>{a}</li>)}
      </ul>
    </div>

    <div class="sdg__mosaic">
      <Picture
        class="sdg__img sdg__img--tall"
        src={photo('rice-red-texture')}
        formats={['avif', 'webp']}
        widths={[400, 700, 1000]}
        sizes="(min-width: 900px) 25vw, 50vw"
        alt="Close-up of unpolished red rice grains"
      />
      <Picture
        class="sdg__img"
        src={photo('coconut-oil')}
        formats={['avif', 'webp']}
        widths={[300, 600]}
        sizes="(min-width: 900px) 20vw, 50vw"
        alt="Split coconuts beside a bottle of coconut oil"
      />
      <div class="sdg__goals" aria-hidden="true">
        <span>17</span>
        UN Sustainable Development Goals
      </div>
    </div>
  </div>
</section>

<style>
  .sdg {
    margin: 0 var(--s-3);
    padding-block: var(--section);
    border-radius: var(--r-panel);
    background: var(--green);
    color: var(--on-dark);
  }

  .sdg__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--s-8);
    align-items: center;
  }

  .sdg__text {
    display: grid;
    gap: var(--s-4);
  }

  .sdg h2 {
    color: var(--cream);
  }

  .sdg .eyebrow,
  .sdg .hl {
    color: var(--yellow);
  }

  .sdg .hl {
    text-decoration: none;
  }

  .sdg .lead {
    color: #dbe6d6;
  }

  .sdg__list {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-3);
  }

  .sdg__list li {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    font-weight: 700;
    color: var(--cream);
  }

  .sdg__list li::before {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--yellow);
    flex: none;
  }

  .sdg__mosaic {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: var(--s-3);
    height: 30rem;
  }

  .sdg__mosaic :global(picture) {
    min-height: 0;
  }

  .sdg__mosaic :global(picture:first-child) {
    grid-row: 1 / span 2;
  }

  .sdg__mosaic :global(.sdg__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--r-card);
  }

  .sdg__goals {
    display: grid;
    align-content: end;
    padding: var(--s-5);
    border-radius: var(--r-card);
    background: var(--yellow);
    color: var(--forest);
    font-weight: 800;
    line-height: 1.3;
  }

  .sdg__goals span {
    font-family: var(--font-display);
    font-size: 5rem;
    font-weight: 400;
    line-height: 0.9;
  }

  @media (max-width: 899px) {
    .sdg__grid {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
    .sdg__mosaic {
      height: 22rem;
    }
  }
</style>
