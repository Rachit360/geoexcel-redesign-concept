---
import { sdg } from '../../data/company';
---

<section class="sdg" id="sustainability" aria-labelledby="sdg-title">
  <div class="wrap sdg__grid">
    <div class="intro">
      <p class="eyebrow">Sustainability</p>
      <h2 id="sdg-title">Committed to the <span class="hl">UN SDGs</span> since {sdg.since}.</h2>
      <p class="lead">{sdg.statement}</p>
      <ul class="sdg__approach" role="list" aria-label="Our approach">
        {sdg.approach.map((a) => <li>{a}</li>)}
      </ul>
    </div>
    <div class="sdg__principles" data-reveal>
      <p class="sdg__label">Principles Geo Excel follows</p>
      <ol role="list">
        {sdg.principles.map((p, i) => <li><span aria-hidden="true">{i + 1}</span>{p}</li>)}
      </ol>
      <p class="sdg__note">As published by Geo Excel.</p>
    </div>
  </div>
</section>

<style>
  .sdg {
    margin: 0 var(--s-3);
    padding-block: var(--section);
    border-radius: var(--r-panel);
    background: var(--green);
    color: var(--on-dark);
  }

  .sdg h2 {
    color: var(--cream);
  }

  .sdg .eyebrow {
    color: var(--yellow);
  }

  .sdg .lead {
    color: #dbe6d6;
  }

  .sdg .hl {
    background: none;
    color: var(--yellow);
  }

  .sdg__grid {
    display: grid;
    grid-template-columns: 6fr 6fr;
    gap: var(--s-7);
    align-items: center;
  }

  .sdg__grid .intro {
    margin-bottom: 0;
  }

  .sdg__approach {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-3);
  }

  .sdg__approach li {
    padding: 0.45rem 0.9rem;
    border: 1.5px solid rgba(234, 235, 219, 0.5);
    border-radius: var(--r-pill);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--cream);
  }

  .sdg__principles {
    padding: var(--s-6);
    border-radius: var(--r-card);
    background: var(--cream-2);
    color: var(--text);
  }

  .sdg__label {
    margin-bottom: var(--s-4);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
  }

  .sdg__principles ol {
    display: grid;
    gap: 0;
  }

  .sdg__principles li {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: var(--s-3);
    align-items: center;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
    font-weight: 600;
    color: var(--forest);
  }

  .sdg__principles li span {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--sage);
    font-family: var(--font-display);
    font-size: 1.125rem;
    padding-top: 0.1rem;
  }

  .sdg__note {
    margin-top: var(--s-3);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  @media (max-width: 899px) {
    .sdg__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
