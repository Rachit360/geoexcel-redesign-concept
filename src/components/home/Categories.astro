---
import { Picture } from 'astro:assets';
import { categories } from '../../data/catalogue';
import { photo } from '../../lib/images';
import { url } from '../../lib/paths';
---

<section class="section wrap" aria-labelledby="categories-title">
  <div class="intro intro--center">
    <p class="eyebrow">What we export</p>
    <h2 id="categories-title">Four categories, <span class="hl">one supplier.</span></h2>
    <p class="lead">Source rice, spices, frozen foods and edible oils through a single, registered exporter.</p>
  </div>

  <ul class="cats" role="list">
    {
      categories.map((c) => (
        <li data-reveal>
          <a class="cat" href={url(`/products/?category=${c.slug}`)}>
            <Picture
              src={photo(c.photo)}
              formats={['avif', 'webp']}
              widths={[360, 560, 800]}
              sizes="(min-width: 1024px) 24vw, (min-width: 640px) 48vw, 100vw"
              alt=""
            />
            <span class="cat__body">
              <span class="cat__count">
                <span class="marker" data-marker={c.marker} />
                {c.products.length} products
              </span>
              <span class="cat__name">{c.name}</span>
              <span class="cat__lede">{c.lede}</span>
              <span class="cat__go" aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .cats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .cat {
    position: relative;
    display: grid;
    height: 100%;
    min-height: 26rem;
    overflow: hidden;
    border-radius: var(--r-card);
    background: var(--forest);
    color: var(--cream);
    text-decoration: none;
  }

  .cat :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }

  .cat::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17, 42, 32, 0) 30%, rgba(17, 42, 32, 0.92) 85%);
  }

  .cat__body {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: end;
    gap: 0.4rem;
    padding: var(--s-5);
  }

  .cat__count {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    justify-self: start;
    padding: 0.3rem 0.7rem;
    border-radius: var(--r-pill);
    background: var(--cream);
    color: var(--forest);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .cat__name {
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .cat__lede {
    font-size: 0.875rem;
    color: #d3dbcf;
  }

  .cat__go {
    position: absolute;
    right: var(--s-5);
    top: var(--s-5);
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--orange-ink);
    color: var(--white);
    transition: transform 250ms var(--ease);
  }

  .cat:hover :global(img) {
    transform: scale(1.06);
  }

  .cat:hover .cat__go {
    transform: rotate(-45deg);
  }

  @media (max-width: 1023px) {
    .cats {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 539px) {
    .cats {
      grid-template-columns: 1fr;
    }
    .cat {
      min-height: 18rem;
    }
  }
</style>
