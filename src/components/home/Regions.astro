---
import { regions } from '../../data/catalogue';

const shown = regions.slice(0, 6);
---

<section class="regions on-dark" aria-labelledby="regions-title">
  <div class="wrap">
    <div class="regions__head">
      <div class="intro">
        <p class="eyebrow">Geographic Excellence</p>
        <h2 id="regions-title">Each product, from the region <span class="hl">that grows it.</span></h2>
      </div>
      <p class="lead">
        The name is the idea: every Geo Excel product names its Indian region of origin — basmati from Punjab, cardamom
        and pepper from Kerala, Sona Masuri from Karnataka and Andhra Pradesh.
      </p>
    </div>

    <ul class="regions__grid" role="list">
      {
        shown.map((r) => (
          <li data-reveal>
            <p class="regions__state">{r.state}</p>
            <p class="regions__count">
              {r.products.length} {r.products.length === 1 ? 'product' : 'products'}
            </p>
            <p class="regions__list">{r.products.map((p) => p.name).join(' · ')}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .regions {
    margin: 0 var(--s-3);
    padding-block: var(--section);
    border-radius: var(--r-panel);
    background: var(--forest);
    color: var(--on-dark);
  }

  .regions h2 {
    color: var(--cream);
  }

  .regions__head {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--s-6);
    align-items: end;
    margin-bottom: var(--s-7);
  }

  .regions__head .intro {
    margin-bottom: 0;
  }

  .regions__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .regions__grid li {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: var(--s-5);
    border-radius: var(--r-card);
    background: rgba(234, 235, 219, 0.07);
    border: 1px solid rgba(234, 235, 219, 0.12);
  }

  .regions__state {
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 1;
    text-transform: uppercase;
    color: var(--cream);
  }

  .regions__count {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--yellow);
  }

  .regions__list {
    font-size: 0.9375rem;
    color: var(--on-dark-muted);
  }

  @media (max-width: 899px) {
    .regions__head {
      grid-template-columns: 1fr;
    }
    .regions__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 539px) {
    .regions__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
