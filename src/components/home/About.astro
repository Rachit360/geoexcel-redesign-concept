---
import { Picture } from 'astro:assets';
import { heritage, verticals } from '../../data/company';
import { photo } from '../../lib/images';
---

<section class="section about wrap" id="about" aria-labelledby="about-title">
  <div class="about__media" data-reveal>
    <Picture
      src={photo('sesame-spoons')}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200]}
      sizes="(min-width: 900px) 40vw, 100vw"
      alt="White and black sesame seeds in wooden spoons"
    />
    <p class="about__badge"><span>Sesame</span> one of the family’s first crops</p>
  </div>

  <div class="about__body">
    <div class="intro">
      <p class="eyebrow">About Geo Excel</p>
      <h2 id="about-title">Farmers first. <span class="hl">Exporters</span> today.</h2>
      <p class="lead">
        Geo Excel — short for <strong>Geographic Excellence</strong> — is the export business of a Bengaluru family
        group. It began by growing rice, sugarcane and sesame, moved into cement, steel and construction, and in 2023
        turned that experience to international trade.
      </p>
    </div>

    <ol class="timeline" role="list">
      {
        heritage.map((h) => (
          <li>
            <span class="timeline__year">{h.year}</span>
            <span class="timeline__title">{h.title}</span>
          </li>
        ))
      }
    </ol>

    <div class="verticals">
      <p class="verticals__label">The Group today</p>
      <ul role="list">
        {verticals.map((v) => <li class:list={{ 'is-active': v === 'Trading' }}>{v}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--s-8);
    align-items: center;
  }

  .about__media {
    position: relative;
  }

  .about__media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--r-panel);
  }

  .about__badge {
    position: absolute;
    left: var(--s-5);
    bottom: var(--s-5);
    padding: 0.7rem 1rem;
    border-radius: var(--r-inner);
    background: var(--white);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .about__badge span {
    display: block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    text-transform: uppercase;
    color: var(--forest);
  }

  .about__body {
    display: grid;
    gap: var(--s-6);
  }

  .about .intro {
    margin-bottom: 0;
  }

  .lead strong {
    color: var(--forest);
  }

  .timeline {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .timeline li {
    display: grid;
    gap: 0.25rem;
    padding-top: var(--s-3);
    border-top: 3px solid var(--forest);
  }

  .timeline li:last-child {
    border-top-color: var(--orange);
  }

  .timeline__year {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--forest);
  }

  .timeline__title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
  }

  .verticals {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
  }

  .verticals__label {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .verticals ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .verticals li {
    padding: 0.4rem 0.9rem;
    border: 1.5px solid var(--forest);
    border-radius: var(--r-pill);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--forest);
  }

  .verticals li.is-active {
    background: var(--forest);
    color: var(--cream);
  }

  @media (max-width: 899px) {
    .about {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
    .about__media :global(img) {
      aspect-ratio: 4 / 3;
    }
    .timeline {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: var(--s-4);
    }
  }
</style>
