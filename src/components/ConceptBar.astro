---
import { company } from '../data/company';
import { url } from '../lib/paths';
---

<aside class="concept-bar" aria-label="Concept notice">
  <div class="wrap concept-bar__inner">
    <p>
      <span class="concept-bar__tag">Concept</span>
      Redesign proposal — not the official Geo Excel website.
      <a href={company.officialSite} rel="noopener">Official site</a>
      <a href={url('/about-this-redesign/')}>About this redesign</a>
    </p>
  </div>
</aside>

<style>
  .concept-bar {
    background: var(--ink);
    color: var(--on-ink-muted);
    font-size: 0.8125rem;
  }

  .concept-bar__inner {
    padding-block: 0.5rem;
  }

  .concept-bar p {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.9rem;
  }

  .concept-bar__tag {
    padding: 0.1rem 0.45rem 0.05rem;
    background: var(--mark-orange);
    color: var(--ink);
    font: 800 0.8125rem/1.2 var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .concept-bar a {
    color: var(--bone);
    text-underline-offset: 0.2em;
  }
</style>
