---
import Logo from './Logo.astro';
import { categories } from '../data/catalogue';
import { company, fullAddress } from '../data/company';
import { url } from '../lib/paths';
---

<footer class="footer on-dark">
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo inverse />
        <p>Geo Excel — Geographic Excellence. Merchant exporter of Indian rice, spices, frozen foods, edible oils and ghee.</p>
      </div>
      <nav aria-label="Footer">
        <p class="footer__head">Products</p>
        <ul role="list">
          {categories.map((c) => <li><a href={url(`/products/?category=${c.slug}`)}>{c.shortName}</a></li>)}
        </ul>
      </nav>
      <div>
        <p class="footer__head">Company</p>
        <ul role="list">
          <li><a href={url('/#about')}>About Geo Excel</a></li>
          <li><a href={url('/#process')}>How to trade</a></li>
          <li><a href={url('/#certifications')}>Registrations</a></li>
          <li><a href={url('/#sustainability')}>Sustainability</a></li>
        </ul>
      </div>
      <div>
        <p class="footer__head">Contact</p>
        <address>{fullAddress.map((l) => <span>{l}</span>)}</address>
        <ul role="list">
          <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
          <li><a href={company.phone.href}>{company.phone.display}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__legal">
      <p>© {new Date().getFullYear()} {company.legalName}</p>
      <p>Concept redesign for review — not the official website. <a href={company.officialSite} rel="noopener">geoexcel.group</a></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin: 0 var(--s-3) var(--s-3);
    padding-block: var(--s-8) var(--s-5);
    border-radius: var(--r-panel);
    background: var(--forest);
    color: var(--on-dark-muted);
    font-size: 0.9375rem;
  }

  .footer a {
    color: var(--cream);
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--yellow);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: var(--s-7) var(--gutter);
    padding-bottom: var(--s-7);
  }

  .footer__brand {
    display: grid;
    gap: var(--s-4);
    align-content: start;
    max-width: 22rem;
  }

  .footer__head {
    margin-bottom: var(--s-4);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--yellow);
  }

  .footer ul {
    display: grid;
    gap: 0.5rem;
  }

  address {
    display: grid;
    margin-bottom: var(--s-4);
    font-style: normal;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3);
    padding-top: var(--s-5);
    border-top: 1px solid rgba(234, 235, 219, 0.15);
    font-size: 0.8125rem;
  }

  .footer__legal a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 899px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand,
    .footer__top > :last-child {
      grid-column: 1 / -1;
    }
  }
</style>
