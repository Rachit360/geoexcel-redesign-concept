---
import { company } from '../data/company';
import { url } from '../lib/paths';

interface Props {
  title?: string;
}
const { title = 'Send us your spec.' } = Astro.props;
---

<section class="section section--red enquiry-band on-ink" aria-labelledby="enquiry-band-title">
  <div class="wrap">
    <p class="label">Request a quote</p>
    <h2 id="enquiry-band-title" class="enquiry-band__title">{title}</h2>
    <div class="enquiry-band__row">
      <p class="lead">
        Product, grade, quantity, packing and destination port — in one enquiry, built from the product sheets.
      </p>
      <div class="btn-row">
        <a class="btn btn--on-ink" href={url('/enquiry/')}>Request a quote</a>
        <a class="btn btn--ghost-on-ink" href={url('/products/')}>Browse products</a>
      </div>
      <dl class="enquiry-band__contact">
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${company.email}`}>{company.email}</a></dd>
        </div>
        <div>
          <dt>Telephone</dt>
          <dd><a href={company.phone.href}>{company.phone.display}</a></dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .enquiry-band {
    background-image: repeating-linear-gradient(-45deg, rgba(0, 0, 0, 0.05) 0 2px, transparent 2px 9px);
  }

  .enquiry-band__title {
    margin-top: var(--s-4);
    font-size: var(--step-poster);
    line-height: 0.82;
    max-width: 9em;
  }

  .enquiry-band__row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) auto minmax(0, 3fr);
    gap: var(--s-6);
    align-items: end;
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 3px solid var(--bone);
  }

  .enquiry-band .lead {
    color: var(--bone);
  }

  .enquiry-band .btn--on-ink {
    --btn-fg: var(--red);
  }

  .enquiry-band .btn:hover {
    box-shadow: 3px 3px 0 var(--ink);
  }

  .enquiry-band__contact {
    display: grid;
    gap: var(--s-3);
    justify-items: end;
    text-align: right;
  }

  .enquiry-band__contact dt {
    font: 800 0.875rem/1 var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f3d2cf;
  }

  .enquiry-band__contact a {
    font: 750 1.375rem/1.2 var(--font-display);
    letter-spacing: 0.03em;
    color: var(--bone);
    text-decoration: none;
  }

  .enquiry-band__contact a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 1023px) {
    .enquiry-band__row {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .enquiry-band__contact {
      justify-items: start;
      text-align: left;
    }
  }
</style>
