---
import { Picture } from 'astro:assets';
import { categories, footwear } from '../data/catalogue';
import { categoryUrl } from '../lib/paths';
import { photo } from '../lib/images';

interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel = 'h3' } = Astro.props;
const H = headingLevel;

const boardPhoto: Record<string, string> = { 'frozen-foods': 'frozen-peas-macro' };
const unit: Record<string, string> = { rice: 'grades', spices: 'spices', 'frozen-foods': 'products', 'edible-oils-ghee': 'oils & ghee' };
---

<div class="board">
  <ol class="board__grid" role="list">
    {
      categories.map((c) => (
        <li class="board__item" style={`--band: var(--mark-${c.marker})`}>
          <a class="board__link" href={categoryUrl(c.slug)}>
            <span class="board__img ratio">
              <Picture src={photo(boardPhoto[c.slug] ?? c.photo)} formats={['avif', 'webp']} widths={[360, 560, 800]} sizes="(min-width: 1024px) 24vw, (min-width: 640px) 48vw, 100vw" alt="" />
            </span>
            <span class="board__body">
              <span class="board__num numeral" aria-hidden="true">{c.number}</span>
              <H class="board__name">{c.shortName}</H>
              <span class="board__count num">
                {c.products.length} {unit[c.slug]}
              </span>
              <span class="board__names">{c.products.slice(0, 4).map((p) => p.name).join(' / ')}</span>
              <span class="board__go" aria-hidden="true">View sheets →</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
  <a class="board__extra" href={categoryUrl(footwear.slug)}>
    <span class="num">{footwear.number}</span>
    <span class="board__extra-name">{footwear.name}</span>
    <span class="board__extra-note">Fashion and lifestyle line — current range on request</span>
    <span aria-hidden="true">→</span>
  </a>
</div>

<style>
  .board__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border: 3px solid var(--bone);
  }

  .board__item + .board__item {
    border-left: 3px solid var(--bone);
  }

  .board__link {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    color: var(--bone);
    text-decoration: none;
    background: var(--ink);
  }

  .board__link::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    z-index: 1;
    height: 10px;
    background: var(--band);
    transition: height 300ms var(--ease);
  }

  .board__img {
    aspect-ratio: 4 / 3;
  }

  .board__img :global(img) {
    filter: saturate(0.85) contrast(1.05);
    transition: transform 700ms var(--ease), filter 400ms var(--ease);
  }

  .board__body {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: var(--s-5) var(--s-5) var(--s-6);
  }

  .board__num {
    font-size: clamp(4.5rem, 3rem + 3.5vw, 7.5rem);
    color: var(--band);
    margin-top: -3.4rem;
    position: relative;
    z-index: 1;
    text-shadow: 0 2px 0 var(--ink);
  }

  .board__name {
    font-family: var(--font-stencil);
    font-size: clamp(2rem, 1.5rem + 1.4vw, 3rem);
    font-weight: 850;
    line-height: 0.9;
    color: var(--bone);
  }

  .board__count {
    font-size: 1.125rem;
    color: var(--band);
  }

  .board__names {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--on-ink-muted);
  }

  .board__go {
    margin-top: var(--s-3);
    font: 800 1rem/1 var(--font-display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone);
    transition: transform 250ms var(--ease);
  }

  .board__link:hover::before {
    height: 18px;
  }

  .board__link:hover .board__img :global(img) {
    transform: scale(1.06);
    filter: saturate(1) contrast(1.05);
  }

  .board__link:hover .board__go {
    transform: translateX(6px);
  }

  .board__extra {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-4) var(--s-5);
    border: 3px solid var(--bone);
    border-top: 0;
    color: var(--bone);
    text-decoration: none;
    transition: background-color 200ms var(--ease), color 200ms var(--ease);
  }

  .board__extra .num {
    font-size: 1.25rem;
    color: var(--on-ink-muted);
  }

  .board__extra-name {
    font: 850 1.75rem/1 var(--font-stencil);
    text-transform: uppercase;
  }

  .board__extra-note {
    color: var(--on-ink-muted);
    font-size: 0.9375rem;
  }

  .board__extra:hover {
    background: var(--bone);
    color: var(--ink);
  }

  .board__extra:hover .board__extra-note,
  .board__extra:hover .num {
    color: var(--ink);
  }

  @media (max-width: 1023px) {
    .board__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .board__item:nth-child(3) {
      border-left: 0;
    }
    .board__item:nth-child(n + 3) {
      border-top: 3px solid var(--bone);
    }
  }

  @media (max-width: 639px) {
    .board__grid {
      grid-template-columns: 1fr;
    }
    .board__item + .board__item {
      border-left: 0;
      border-top: 3px solid var(--bone);
    }
    .board__img {
      aspect-ratio: 16 / 9;
    }
    .board__extra {
      grid-template-columns: auto 1fr auto;
    }
    .board__extra-note {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
