---
import { Picture } from 'astro:assets';
import { categories, footwear } from '../data/catalogue';
import { categoryUrl } from '../lib/paths';
import { productImage, photo } from '../lib/images';

interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel = 'h3' } = Astro.props;
const H = headingLevel;

const rows = [
  ...categories.map((c) => ({
    href: categoryUrl(c.slug),
    number: c.number,
    marker: c.marker,
    name: c.name,
    lede: c.lede,
    names: c.products.slice(0, 5).map((p) => p.name),
    count: `${c.products.length} products`,
    image: productImage(c.products[0].image),
  })),
  {
    href: categoryUrl(footwear.slug),
    number: footwear.number,
    marker: footwear.marker,
    name: footwear.name,
    lede: footwear.lede,
    names: [],
    count: 'On request',
    image: photo('shoe-brown-oxford'),
  },
];
---

<ol class="cat-index" role="list">
  {
    rows.map((r) => (
      <li class="cat-index__item">
        <a class="cat-index__link" href={r.href}>
          <span class="cat-index__num mono">{r.number}</span>
          <span class="cat-index__main">
            <H class="cat-index__name">
              <span class="marker" data-marker={r.marker} />
              {r.name}
            </H>
            <span class="cat-index__lede">{r.lede}</span>
            {r.names.length > 0 && <span class="cat-index__names">{r.names.join(' · ')} …</span>}
          </span>
          <span class="cat-index__count mono">{r.count}</span>
          <span class="cat-index__thumb ratio ratio--1x1">
            <Picture src={r.image} formats={['avif', 'webp']} widths={[160, 320]} sizes="160px" alt="" />
          </span>
          <span class="cat-index__arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .cat-index {
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .cat-index__item + .cat-index__item {
    border-top: 1px solid var(--rule);
  }

  .cat-index__link {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) 8rem 6.5rem 1.5rem;
    align-items: center;
    gap: var(--s-5);
    padding: var(--s-5) 0;
    color: inherit;
    text-decoration: none;
    transition: background-color 220ms var(--ease), padding 220ms var(--ease);
  }

  .cat-index__link:hover {
    background: var(--paper-deep);
    padding-inline: var(--s-4);
  }

  .cat-index__num {
    align-self: start;
    padding-top: 0.55rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .cat-index__main {
    display: grid;
    gap: 0.35rem;
  }

  .cat-index__name {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1.2rem + 1.3vw, 2.25rem);
    line-height: 1.1;
    font-weight: 400;
    color: var(--ink);
  }

  .cat-index__lede {
    color: var(--text);
  }

  .cat-index__names {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .cat-index__count {
    font-size: 0.8125rem;
    color: var(--muted);
    text-align: right;
  }

  .cat-index__thumb {
    width: 6.5rem;
  }

  .cat-index__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92);
    transition: transform 400ms var(--ease);
  }

  .cat-index__link:hover .cat-index__thumb :global(img) {
    transform: scale(1.04);
  }

  .cat-index__arrow {
    font-size: 1.25rem;
    color: var(--ink);
    transition: transform 220ms var(--ease);
  }

  .cat-index__link:hover .cat-index__arrow {
    transform: translateX(4px);
  }

  @media (max-width: 899px) {
    .cat-index__link {
      grid-template-columns: 4.5rem minmax(0, 1fr) 1.25rem;
      grid-template-areas:
        'thumb main arrow'
        'thumb count arrow';
      column-gap: var(--s-4);
      row-gap: var(--s-2);
      align-items: start;
    }
    .cat-index__num {
      display: none;
    }
    .cat-index__main {
      grid-area: main;
    }
    .cat-index__count {
      grid-area: count;
      text-align: left;
    }
    .cat-index__thumb {
      grid-area: thumb;
      width: 4.5rem;
    }
    .cat-index__arrow {
      grid-area: arrow;
      align-self: center;
    }
    .cat-index__names {
      display: none;
    }
    .cat-index__link:hover {
      padding-inline: 0;
    }
  }
</style>
