---
/**
 * The "shipping mark": a stencilled export label, as sprayed on a sack.
 * Used once in the hero as an accent; it only carries real company data.
 */
interface Props {
  name: string;
  origin: string;
  lines?: string[];
  class?: string;
}
const { name, origin, lines = [], class: cls } = Astro.props;
---

<div class:list={['mark', cls]}>
  <p class="mark__origin">{origin}</p>
  <p class="mark__name">{name}</p>
  {lines.map((l) => <p class="mark__line">{l}</p>)}
</div>
