---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Register from '../components/Register.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
import { company } from '../data/company';
import { url } from '../lib/paths';
import { photo } from '../lib/images';

const issuers = [
  { name: 'APEDA — Agricultural and Processed Food Products Export Development Authority', href: 'https://apeda.gov.in/' },
  { name: 'DGFT — Directorate General of Foreign Trade (IEC)', href: 'https://www.dgft.gov.in/' },
  { name: 'Udyam Registration — Ministry of MSME', href: 'https://udyamregistration.gov.in/' },
];

const principles = [
  {
    title: 'Typical values, as published',
    text: 'Product sheets reproduce the parameters Geo Excel publishes. Where the company’s own sources gave two different values for the same parameter, the parameter is left out rather than guessed.',
  },
  {
    title: 'International HS codes',
    text: 'HS codes are shown at the internationally harmonised 4- or 6-digit level that applies in every market. The national tariff line is confirmed on the commercial invoice.',
  },
  {
    title: 'The contract is the specification',
    text: 'The specification, packing and documents for each order are agreed in the quotation and the contract. If you require independent inspection or laboratory analysis, include it in your enquiry.',
  },
  {
    title: 'Registrations are dated',
    text: 'The register shows each document’s issue and validity dates, and its status is calculated from them. A document is never shown as current after its validity date.',
  },
];
---

<Base
  title="Quality and registrations"
  description="Geo Excel’s trade registrations — APEDA RCMC, IEC and Udyam — with numbers and validity dates, and how product specifications are presented."
>
  <PageIntro
    crumbs={[{ label: 'Quality and registrations' }]}
    label="Quality and documents"
    title="Registrations you can check."
    lede="The documents that allow Geo Excel to export, listed with their numbers and dates, and the rules this site follows when it publishes a specification."
  />

  <section class="section" aria-labelledby="register-title">
    <div class="wrap">
      <div class="heading heading--split">
        <div class="flow" style="--flow: 1rem">
          <p class="label">The register</p>
          <h2 id="register-title">Current registrations</h2>
        </div>
        <p class="lead">
          Registered to {company.legalName}, {company.address.lines[1]}, {company.address.city}. Copies are available with
          your quotation.
        </p>
      </div>
      <Register detailed />
      <div class="verify">
        <p class="label">Check a registration with the issuer</p>
        <ul role="list">
          {
            issuers.map((i) => (
              <li>
                <a class="link" href={i.href} rel="noopener" target="_blank">
                  {i.name}
                  <span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--deep" aria-labelledby="principles-title">
    <div class="wrap grid principles">
      <div class="principles__head">
        <p class="label">Specifications</p>
        <h2 id="principles-title">How product data is presented</h2>
        <figure class="figure">
          <div class="ratio ratio--4x5">
            <Picture src={photo('nutmeg-macro')} formats={['avif', 'webp']} widths={[360, 600]} sizes="(min-width: 900px) 28vw, 100vw" alt="Whole nutmegs" />
          </div>
          <figcaption><span class="mono">Fig. 01</span> Whole nutmeg.</figcaption>
        </figure>
      </div>
      <ol class="principles__list" role="list">
        {
          principles.map((p, i) => (
            <li data-reveal>
              <span class="mono">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="docs-title">
    <div class="wrap grid docs">
      <h2 id="docs-title" class="docs__title">Need a document for your market?</h2>
      <div class="docs__body flow">
        <p>
          Certificates of origin, phytosanitary or health certificates, and laboratory reports depend on the product and
          the destination. List the documents you need in your enquiry so they are confirmed in the quotation.
        </p>
        <p><a class="link link--arrow" href={url('/enquiry/')}>Start an enquiry</a></p>
      </div>
    </div>
  </section>

  <EnquiryBand />
</Base>

<style>
  .verify {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  .verify ul {
    display: grid;
    gap: 0.4rem;
    font-size: 0.9375rem;
  }

  .principles {
    row-gap: var(--s-7);
    align-items: start;
  }

  .principles__head {
    grid-column: 1 / span 4;
    display: grid;
    gap: var(--s-5);
  }

  .principles__head figure {
    max-width: 20rem;
    margin-top: var(--s-4);
  }

  .principles__list {
    grid-column: 6 / span 7;
    border-top: 1px solid var(--ink);
  }

  .principles__list li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--s-4);
    padding: var(--s-6) 0;
    border-bottom: 1px solid var(--rule);
  }

  .principles__list .mono {
    font-size: 0.8125rem;
    color: var(--muted);
    padding-top: 0.45rem;
  }

  .principles__list h3 {
    margin-bottom: var(--s-2);
  }

  .docs {
    row-gap: var(--s-5);
    align-items: start;
  }

  .docs__title {
    grid-column: 1 / span 6;
    font-size: var(--step-h3);
  }

  .docs__body {
    grid-column: 7 / span 6;
  }

  @media (max-width: 899px) {
    .principles__head,
    .principles__list,
    .docs__title,
    .docs__body {
      grid-column: 1 / -1;
    }
  }
</style>
