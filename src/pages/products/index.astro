---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categories, productCount, footwear } from '../../data/catalogue';
import { enquiryHref } from '../../lib/enquiry';
import { photo } from '../../lib/images';
---

<Base
  title="Products — Geo Excel"
  description={`${productCount} export products from Geo Excel: rice, whole spices, frozen foods, edible oils and ghee. Filter by category and send an enquiry.`}
>
  <section class="phead wrap">
    <div class="phead__inner">
    <p class="eyebrow">Our products</p>
    <h1>Everything we export, <span class="hl">in one place.</span></h1>
    <p class="lead">
      {productCount} products across four categories. Choose a category to filter, then enquire about any product. The
      message comes pre-filled with what we need to quote.
    </p>
    </div>
  </section>

  <section class="wrap" aria-label="Product categories">
    <!-- the category tiles are the filter; with JS off everything just shows -->
    <div class="filters" role="group" aria-label="Filter products by category" data-filters>
      <button type="button" class="filter filter--all" data-filter="all" aria-pressed="true">
        <span class="filter__name">All products</span>
        <span class="filter__count">{productCount}</span>
      </button>
      {
        categories.map((c) => (
          <button type="button" class="filter" data-filter={c.slug} aria-pressed="false">
            <Picture src={photo(c.photo)} formats={['avif', 'webp']} widths={[240, 480]} sizes="(min-width: 900px) 18vw, 45vw" alt="" />
            <span class="filter__name">
              <span class="marker" data-marker={c.marker} />
              {c.shortName}
            </span>
            <span class="filter__count">{c.products.length}</span>
          </button>
        ))
      }
    </div>
    <p class="status" role="status" aria-live="polite" data-status>Showing all {productCount} products.</p>
  </section>

  <section class="section wrap plist" aria-label="Products">
    {
      categories.map((c) => (
        <div class="group" data-group={c.slug}>
          <div class="group__head">
            <h2>{c.name}</h2>
            <p>{c.intro}</p>
          </div>
          <ul class="grid" role="list">
            {c.products.map((p) => (
              <li>
                <ProductCard product={p} category={c} />
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="also">
      <p><strong>Also available:</strong> {footwear.lede}</p>
      <a class="btn btn--small btn--dark" href={enquiryHref('Leather footwear')} data-enquiry="Leather footwear">Ask about footwear</a>
    </div>
  </section>
</Base>

<script>
  // Category filter. The choice goes in the URL (?category=rice) so the
  // homepage category cards can link straight to a filtered view.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
  const status = document.querySelector<HTMLElement>('[data-status]');

  function applyFilter(slug: string, updateUrl = true) {
    const valid = slug === 'all' || groups.some((g) => g.dataset.group === slug);
    const active = valid ? slug : 'all';

    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === active)));
    groups.forEach((g) => (g.hidden = active !== 'all' && g.dataset.group !== active));

    const count = groups.filter((g) => !g.hidden).reduce((n, g) => n + g.querySelectorAll('li').length, 0);
    const label = active === 'all' ? 'all' : buttons.find((b) => b.dataset.filter === active)?.querySelector('.filter__name')?.textContent?.trim();
    if (status) status.textContent = `Showing ${active === 'all' ? 'all ' : ''}${count} ${active === 'all' ? '' : label + ' '}products.`.replace(/\s+/g, ' ');

    if (updateUrl) {
      const url = new URL(location.href);
      if (active === 'all') url.searchParams.delete('category');
      else url.searchParams.set('category', active);
      history.replaceState(null, '', url);
    }
  }

  buttons.forEach((b) => b.addEventListener('click', () => applyFilter(b.dataset.filter!)));
  applyFilter(new URLSearchParams(location.search).get('category') ?? 'all', false);
</script>

<style>
  .phead {
    padding-block: var(--s-8) var(--s-6);
  }

  .phead__inner {
    display: grid;
    gap: var(--s-4);
    max-width: 52rem;
  }

  .phead h1 {
    font-size: clamp(3rem, 1.8rem + 5vw, 6.5rem);
  }

  .filters {
    display: grid;
    grid-template-columns: 0.8fr repeat(4, 1fr);
    gap: var(--s-3);
  }

  .filter {
    position: relative;
    display: grid;
    align-content: end;
    gap: 0.2rem;
    min-height: 9.5rem;
    padding: var(--s-4);
    overflow: hidden;
    border: 3px solid transparent;
    border-radius: var(--r-card);
    background: var(--forest);
    color: var(--cream);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 200ms var(--ease);
  }

  .filter :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease);
  }

  .filter:not(.filter--all)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17, 42, 32, 0.05) 20%, rgba(17, 42, 32, 0.88) 100%);
  }

  .filter > span {
    position: relative;
    z-index: 1;
  }

  .filter__name {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .filter__count {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #d3dbcf;
  }

  .filter:hover :global(img) {
    transform: scale(1.06);
  }

  .filter[aria-pressed='true'] {
    border-color: var(--orange);
  }

  .filter--all[aria-pressed='true'] {
    background: var(--orange-ink);
  }

  .filter--all .filter__count {
    color: var(--cream);
  }

  .status {
    margin-top: var(--s-4);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }

  .plist {
    display: grid;
    gap: var(--s-8);
    padding-top: var(--s-6);
  }

  .group[hidden] {
    display: none;
  }

  .group__head {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--s-5);
    align-items: end;
    margin-bottom: var(--s-5);
    padding-bottom: var(--s-4);
    border-bottom: 2px solid var(--forest);
  }

  .group__head h2 {
    font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3.5rem);
  }

  .group__head p {
    max-width: 40rem;
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .also {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-5) var(--s-6);
    border-radius: var(--r-card);
    background: var(--cream-2);
  }

  .also strong {
    color: var(--forest);
  }

  @media (max-width: 1023px) {
    .filters {
      grid-template-columns: repeat(2, 1fr);
    }
    .filter--all {
      grid-column: 1 / -1;
      min-height: 4rem;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .filter {
      min-height: 7.5rem;
    }
    .group__head {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 479px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
