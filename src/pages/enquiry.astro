---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { categories } from '../data/catalogue';
import { company } from '../data/company';
import { publicRegister } from '../data/registrations';
import { productUrl, url } from '../lib/paths';

/** Product lookup for the client script: id -> details, including published pack sizes. */
const catalogue = Object.fromEntries(
  categories.flatMap((c) =>
    c.products.map((p) => [
      `${c.slug}/${p.slug}`,
      {
        id: `${c.slug}/${p.slug}`,
        name: p.name,
        categoryName: c.shortName,
        number: c.number,
        href: productUrl(c.slug, p.slug),
        packing: p.packing?.sizes ?? '',
        unit: c.slug === 'edible-oils-ghee' ? 'litres' : 'kg',
      },
    ]),
  ),
);

const incoterms = [
  ['FOB', 'Free on Board — named port of loading'],
  ['CFR', 'Cost and Freight — named port of destination'],
  ['CIF', 'Cost, Insurance and Freight — named port of destination'],
  ['FCA', 'Free Carrier — named place'],
  ['EXW', 'Ex Works — named place'],
  ['DAP', 'Delivered at Place — named place of destination'],
  ['', 'Not sure yet — please advise'],
];

const buyerTypes = [
  'Importer or distributor',
  'Wholesaler',
  'Food manufacturer or processor',
  'Retailer or private label',
  'Food service',
  'Trading company',
  'Other',
];
---

<Base
  title="Request a quote"
  description="Build a quote list from Geo Excel product sheets, add quantities, packing, destination port and Incoterm, and send one structured enquiry."
>
  <PageIntro
    crumbs={[{ label: 'Request a quote' }]}
    label="Enquiry"
    title="Request a quote"
    lede="One structured enquiry for every product you need. Your list is kept in this browser until you send it; nothing is stored on a server."
  />

  <section class="section section--tight">
    <div class="wrap enquiry">
      <form class="enquiry__form" novalidate data-enquiry-form>
        <div class="errors" tabindex="-1" hidden data-error-summary role="alert">
          <h2 class="errors__title">Please check the following</h2>
          <ul role="list" data-error-list></ul>
        </div>

        <!-- 01 Products -->
        <fieldset class="step" aria-labelledby="step-products">
          <div class="step__head">
            <span class="step__num numeral" aria-hidden="true">01</span>
            <div>
              <h2 id="step-products">Products</h2>
              <p class="muted small">Quantities and packing for each line. Pack sizes listed are those Geo Excel publishes.</p>
            </div>
          </div>

          <ol class="lines" role="list" data-lines></ol>

          <div class="lines__empty" data-lines-empty hidden>
            <p>Your quote list is empty. Add products from the <a class="link" href={url('/products/')}>product index</a>, or choose one below.</p>
          </div>

          <div class="adder">
            <div class="field">
              <label for="add-product">Add a product</label>
              <select id="add-product" data-add-select>
                <option value="">Choose a product…</option>
                {
                  categories.map((c) => (
                    <optgroup label={`${c.number} ${c.name}`}>
                      {c.products.map((p) => (
                        <option value={`${c.slug}/${p.slug}`}>{p.name}</option>
                      ))}
                    </optgroup>
                  ))
                }
                <optgroup label="05 Leather footwear">
                  <option value="leather-footwear">Leather footwear — current range</option>
                </optgroup>
              </select>
            </div>
            <button class="btn btn--secondary" type="button" data-add-button>Add to list</button>
          </div>
          <p class="error-inline" hidden data-lines-error><span>Add at least one product to your quote list.</span></p>
        </fieldset>

        <!-- 02 Shipment -->
        <fieldset class="step" aria-labelledby="step-shipment">
          <div class="step__head">
            <span class="step__num numeral" aria-hidden="true">02</span>
            <div>
              <h2 id="step-shipment">Shipment</h2>
              <p class="muted small">Where the goods are going, and on what terms.</p>
            </div>
          </div>
          <div class="fields">
            <div class="field">
              <label for="dest-country">Destination country <span class="req" aria-hidden="true">*</span></label>
              <input id="dest-country" name="destinationCountry" autocomplete="country-name" required data-label="Destination country" />
              <p class="error" hidden></p>
            </div>
            <div class="field">
              <label for="dest-port">Destination port or city</label>
              <input id="dest-port" name="destinationPort" placeholder="e.g. Jebel Ali, Rotterdam" />
            </div>
            <div class="field">
              <label for="incoterm">Incoterm</label>
              <select id="incoterm" name="incoterm">
                {incoterms.map(([v, l]) => <option value={v}>{v ? `${v} — ${l.split(' — ')[0]}` : l}</option>)}
              </select>
              <p class="hint"><a class="link" href={url('/how-we-work/#incoterms')}>What the Incoterms mean</a></p>
            </div>
            <div class="field">
              <label for="shipment">Target shipment</label>
              <input id="shipment" name="shipment" type="month" placeholder="YYYY-MM" />
            </div>
            <div class="field field--wide">
              <fieldset class="radios">
                <legend>Order type</legend>
                <label><input type="radio" name="frequency" value="One-off order" checked /> One-off order</label>
                <label><input type="radio" name="frequency" value="Recurring supply" /> Recurring supply</label>
                <label><input type="radio" name="frequency" value="Samples first" /> Samples first</label>
              </fieldset>
            </div>
          </div>
        </fieldset>

        <!-- 03 Details -->
        <fieldset class="step" aria-labelledby="step-details">
          <div class="step__head">
            <span class="step__num numeral" aria-hidden="true">03</span>
            <div>
              <h2 id="step-details">Your details</h2>
              <p class="muted small">So the quotation reaches the right person.</p>
            </div>
          </div>
          <div class="fields">
            <div class="field">
              <label for="name">Full name <span class="req" aria-hidden="true">*</span></label>
              <input id="name" name="name" autocomplete="name" required data-label="Full name" />
              <p class="error" hidden></p>
            </div>
            <div class="field">
              <label for="company">Company <span class="req" aria-hidden="true">*</span></label>
              <input id="company" name="company" autocomplete="organization" required data-label="Company" />
              <p class="error" hidden></p>
            </div>
            <div class="field">
              <label for="email">Business email <span class="req" aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" required data-label="Business email" />
              <p class="error" hidden></p>
            </div>
            <div class="field">
              <label for="phone">Phone or WhatsApp</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="Include country code" />
            </div>
            <div class="field">
              <label for="country">Your country <span class="req" aria-hidden="true">*</span></label>
              <input id="country" name="country" autocomplete="country-name" required data-label="Your country" />
              <p class="error" hidden></p>
            </div>
            <div class="field">
              <label for="buyer">Business type</label>
              <select id="buyer" name="buyerType">
                <option value="">Select…</option>
                {buyerTypes.map((b) => <option>{b}</option>)}
              </select>
            </div>
            <div class="field field--wide">
              <label for="message">Anything else</label>
              <textarea id="message" name="message" rows="4" placeholder="Lab analysis, labelling, private label, certificates required for your market…"></textarea>
            </div>
            <div class="field field--wide checks">
              <label class="check">
                <input type="checkbox" name="documents" value="yes" />
                <span>Please include copies of Geo Excel’s registrations ({publicRegister.map((r) => r.issuerShort).join(', ')}).</span>
              </label>
              <label class="check">
                <input type="checkbox" name="consent" required data-label="Consent" />
                <span>I agree that Geo Excel may use these details to respond to this enquiry. <span class="req" aria-hidden="true">*</span></span>
              </label>
              <p class="error" hidden></p>
            </div>
          </div>
        </fieldset>

        <div class="submit">
          <button class="btn" type="submit">Review enquiry</button>
          <p class="small muted">You will see the complete enquiry before anything is sent.</p>
        </div>
      </form>

      <aside class="summary" aria-labelledby="summary-title">
        <div class="summary__inner">
          <p class="label" id="summary-title">Quote list</p>
          <p class="summary__count"><span class="numeral" data-summary-count>0</span> <span data-summary-noun>products</span></p>
          <ol role="list" class="summary__list" data-summary-list></ol>
          <p class="small muted">Prices, availability and lead times are confirmed in the quotation.</p>
          <hr class="rule" />
          <p class="small">
            Prefer email? Write to <a class="link" href={`mailto:${company.email}`}>{company.email}</a> or call
            <a class="link" href={company.phone.href}>{company.phone.display}</a>.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <!-- Review dialog -->
  <dialog class="review" aria-labelledby="review-title" data-review>
    <div class="review__inner">
      <header class="review__head">
        <div>
          <p class="label">Enquiry ready to send</p>
          <h2 id="review-title">Review your enquiry</h2>
        </div>
        <button class="review__close" type="button" data-review-close aria-label="Close and edit">×</button>
      </header>
      <pre class="review__text mono" data-review-text tabindex="0"></pre>
      <p class="small muted review__note">
        This concept site has no server. “Send by email” opens your email app with the enquiry addressed to
        {company.email}; nothing is sent until you press send there. You can also copy the text.
      </p>
      <div class="btn-row review__actions">
        <a class="btn" href="#" data-send-mail>Send by email</a>
        <button class="btn btn--secondary" type="button" data-copy>Copy enquiry text</button>
        <button class="btn btn--secondary" type="button" data-review-close>Edit</button>
      </div>
    </div>
  </dialog>

  <script id="catalogue-data" type="application/json" set:html={JSON.stringify(catalogue)} />
  <script define:vars={{ email: company.email }}>
    window.__GX_EMAIL__ = email;
  </script>
</Base>

<script>
  import { quote, type QuoteItem } from '../scripts/quote-store';

  type Entry = QuoteItem & { packing: string; unit: string };
  const catalogue: Record<string, Entry> = JSON.parse(document.getElementById('catalogue-data')!.textContent!);
  const email = (window as unknown as { __GX_EMAIL__: string }).__GX_EMAIL__;
  const base = (import.meta.env.BASE_URL as string).replace(/\/$/, '');

  const FOOTWEAR: Entry = {
    id: 'leather-footwear',
    name: 'Leather footwear — current range',
    categoryName: 'Leather footwear',
    number: '05',
    href: `${base}/products/leather-footwear/`,
    packing: '',
    unit: 'pairs',
  };

  const lookup = (id: string): Entry | undefined => (id === FOOTWEAR.id ? FOOTWEAR : catalogue[id]);

  const form = document.querySelector<HTMLFormElement>('[data-enquiry-form]')!;
  const linesEl = document.querySelector<HTMLOListElement>('[data-lines]')!;
  const emptyEl = document.querySelector<HTMLElement>('[data-lines-empty]')!;
  const linesError = document.querySelector<HTMLElement>('[data-lines-error]')!;
  const addSelect = document.querySelector<HTMLSelectElement>('[data-add-select]')!;
  const addButton = document.querySelector<HTMLButtonElement>('[data-add-button]')!;
  const summaryList = document.querySelector<HTMLOListElement>('[data-summary-list]')!;
  const summaryCount = document.querySelector<HTMLElement>('[data-summary-count]')!;
  const summaryNoun = document.querySelector<HTMLElement>('[data-summary-noun]')!;
  const errorSummary = document.querySelector<HTMLElement>('[data-error-summary]')!;
  const errorList = document.querySelector<HTMLUListElement>('[data-error-list]')!;
  const review = document.querySelector<HTMLDialogElement>('[data-review]')!;
  const reviewText = document.querySelector<HTMLElement>('[data-review-text]')!;
  const sendMail = document.querySelector<HTMLAnchorElement>('[data-send-mail]')!;

  /* Line-item details typed by the buyer, kept while they edit the list. */
  const DRAFT_KEY = 'gx-quote-lines-v1';
  let draft: Record<string, { qty: string; unit: string; packing: string; notes: string }> = {};
  try {
    draft = JSON.parse(sessionStorage.getItem(DRAFT_KEY) || '{}');
  } catch {
    draft = {};
  }
  const saveDraft = () => {
    try {
      sessionStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
    } catch {
      /* ignore */
    }
  };

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  function lineMarkup(item: QuoteItem, i: number) {
    const entry = lookup(item.id);
    const d = draft[item.id] ?? { qty: '', unit: entry?.unit ?? 'kg', packing: '', notes: '' };
    const uid = item.id.replace(/[^a-z0-9]/gi, '-');
    const units = ['kg', 'metric tonnes', 'litres', '20 ft containers', '40 ft containers', 'pairs', 'cartons'];
    return `
      <li class="line" data-id="${esc(item.id)}">
        <div class="line__head">
          <span class="mono line__num">${String(i + 1).padStart(2, '0')}</span>
          <div class="line__title">
            <a href="${esc(item.href)}">${esc(item.name)}</a>
            <span class="muted small"><span class="mono">${esc(item.number)}</span> ${esc(item.categoryName)}${
              entry?.packing ? ` · Published pack sizes: ${esc(entry.packing)}` : ''
            }</span>
          </div>
          <button type="button" class="line__remove" data-remove="${esc(item.id)}">Remove<span class="visually-hidden"> ${esc(item.name)}</span></button>
        </div>
        <div class="line__fields">
          <div class="field">
            <label for="qty-${uid}">Quantity <span class="req" aria-hidden="true">*</span></label>
            <input id="qty-${uid}" inputmode="decimal" data-line-field="qty" value="${esc(d.qty)}" required data-label="Quantity for ${esc(item.name)}" />
            <p class="error" hidden></p>
          </div>
          <div class="field">
            <label for="unit-${uid}">Unit</label>
            <select id="unit-${uid}" data-line-field="unit">
              ${units.map((u) => `<option${u === d.unit ? ' selected' : ''}>${u}</option>`).join('')}
            </select>
          </div>
          <div class="field">
            <label for="pack-${uid}">Packing preference</label>
            <input id="pack-${uid}" data-line-field="packing" value="${esc(d.packing)}" placeholder="e.g. 25 kg PP bags" />
          </div>
          <div class="field">
            <label for="notes-${uid}">Grade notes</label>
            <input id="notes-${uid}" data-line-field="notes" value="${esc(d.notes)}" placeholder="Optional" />
          </div>
        </div>
      </li>`;
  }

  function render(items: QuoteItem[]) {
    linesEl.innerHTML = items.map(lineMarkup).join('');
    emptyEl.hidden = items.length > 0;
    summaryCount.textContent = String(items.length);
    summaryNoun.textContent = items.length === 1 ? 'product' : 'products';
    summaryList.innerHTML = items
      .map(
        (it) =>
          `<li><span class="mono">${esc(it.number)}</span><a href="${esc(it.href)}">${esc(it.name)}</a></li>`,
      )
      .join('');
    if (items.length) linesError.hidden = true;
  }

  linesEl.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement | HTMLSelectElement;
    const li = el.closest<HTMLElement>('.line');
    const key = el.dataset.lineField as 'qty' | 'unit' | 'packing' | 'notes' | undefined;
    if (!li || !key) return;
    const id = li.dataset.id!;
    draft[id] = draft[id] ?? { qty: '', unit: lookup(id)?.unit ?? 'kg', packing: '', notes: '' };
    draft[id][key] = el.value;
    saveDraft();
  });

  linesEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-remove]');
    if (!btn) return;
    const id = btn.dataset.remove!;
    const index = quote.all().findIndex((i) => i.id === id);
    quote.remove(id);
    const remaining = linesEl.querySelectorAll<HTMLButtonElement>('[data-remove]');
    (remaining[Math.min(index, remaining.length - 1)] ?? addSelect).focus();
  });

  function addById(id: string) {
    const entry = lookup(id);
    if (!entry) return false;
    quote.add({ id: entry.id, name: entry.name, categoryName: entry.categoryName, number: entry.number, href: entry.href });
    return true;
  }

  addButton.addEventListener('click', () => {
    if (!addSelect.value) {
      addSelect.focus();
      return;
    }
    const id = addSelect.value;
    if (addById(id)) {
      addSelect.value = '';
      const input = linesEl.querySelector<HTMLInputElement>(`.line[data-id="${CSS.escape(id)}"] [data-line-field="qty"]`);
      input?.focus();
    }
  });

  quote.onChange(render);

  /* Deep links: /enquiry/?add=<category>/<product> or ?line=leather-footwear */
  const params = new URLSearchParams(location.search);
  const deepLink = params.get('add') || params.get('line');
  if (deepLink) addById(deepLink);
  render(quote.all());

  /* Validation */
  function setError(field: HTMLInputElement | HTMLSelectElement, message: string) {
    const wrap = field.closest('.field');
    const err = wrap?.querySelector<HTMLElement>('.error');
    field.setAttribute('aria-invalid', message ? 'true' : 'false');
    if (err) {
      err.textContent = message;
      err.hidden = !message;
      if (!err.id) err.id = `${field.id || field.name}-error`;
      if (message) field.setAttribute('aria-describedby', err.id);
      else field.removeAttribute('aria-describedby');
    }
  }

  function messageFor(input: HTMLInputElement) {
    const label = input.dataset.label || input.name;
    const value = input.value.trim();
    if (input.type === 'checkbox') return input.checked ? '' : 'Please confirm to continue.';
    if (!value) return `Enter ${label.charAt(0).toLowerCase()}${label.slice(1)}.`;
    if (input.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value))
      return 'Enter an email address in the format name@company.com.';
    if (input.dataset.lineField === 'qty' && !/^\d+([.,]\d+)?$/.test(value)) return 'Enter a number, for example 25000.';
    return '';
  }

  function validate() {
    const problems: { el: HTMLElement; text: string }[] = [];
    const items = quote.all();
    linesError.hidden = items.length > 0;
    if (!items.length) problems.push({ el: addSelect, text: 'Add at least one product to your quote list.' });

    form.querySelectorAll<HTMLInputElement>('input[required]').forEach((input) => {
      const message = messageFor(input);
      setError(input, message);
      if (message) problems.push({ el: input, text: `${input.dataset.label || input.name}: ${message}` });
    });

    errorList.innerHTML = problems
      .map((p, i) => `<li><a href="#${p.el.id}" data-i="${i}">${esc(p.text)}</a></li>`)
      .join('');
    errorSummary.hidden = problems.length === 0;
    return problems;
  }

  errorList.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a');
    if (!a) return;
    e.preventDefault();
    document.getElementById(a.getAttribute('href')!.slice(1))?.focus();
  });

  // Once a field has been flagged, clear its message as soon as the buyer fixes it.
  // Re-checking while typing (not on blur) avoids the layout shifting under the pointer
  // at the moment the buyer clicks the next control.
  function recheck(e: Event) {
    const el = e.target as HTMLInputElement;
    if (!el.matches('input[required]') || el.getAttribute('aria-invalid') !== 'true') return;
    if (!messageFor(el)) setError(el, '');
  }
  form.addEventListener('input', recheck);
  form.addEventListener('change', recheck);

  /* Compose the enquiry */
  function compose() {
    const data = new FormData(form);
    const v = (k: string) => String(data.get(k) ?? '').trim();
    const items = quote.all();
    const ref = `GX-ENQ-${new Date().toISOString().slice(0, 10).replace(/-/g, '')}`;
    const lines = items.map((it, i) => {
      const d = draft[it.id] ?? { qty: '', unit: '', packing: '', notes: '' };
      const parts = [
        `${String(i + 1).padStart(2, '0')}. ${it.name} (${it.number} ${it.categoryName})`,
        `    Quantity: ${d.qty || '—'} ${d.unit || ''}`.trimEnd(),
      ];
      if (d.packing) parts.push(`    Packing: ${d.packing}`);
      if (d.notes) parts.push(`    Notes: ${d.notes}`);
      return parts.join('\n');
    });
    const shipment = v('shipment')
      ? new Date(`${v('shipment')}-01T00:00:00`).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })
      : '';
    // `null` marks an optional line that was left empty; '' is a deliberate section break.
    const text = [
      `QUOTATION REQUEST — ${ref}`,
      '',
      'PRODUCTS',
      ...lines,
      '',
      'SHIPMENT',
      `Destination: ${[v('destinationPort'), v('destinationCountry')].filter(Boolean).join(', ')}`,
      `Incoterm: ${v('incoterm') || 'Not sure — please advise'}`,
      shipment ? `Target shipment: ${shipment}` : null,
      `Order type: ${v('frequency')}`,
      '',
      'BUYER',
      `${v('name')} — ${v('company')}`,
      v('buyerType') ? `Business type: ${v('buyerType')}` : null,
      `Country: ${v('country')}`,
      `Email: ${v('email')}`,
      v('phone') ? `Phone / WhatsApp: ${v('phone')}` : null,
      data.get('documents') ? 'Please include copies of your registrations.' : null,
      ...(v('message') ? ['', 'NOTES', v('message')] : []),
    ]
      .filter((l) => l !== null)
      .join('\n');
    return { ref, text, subject: `Quotation request ${ref} — ${v('company')}` };
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const problems = validate();
    if (problems.length) {
      errorSummary.focus();
      return;
    }
    const { text, subject } = compose();
    reviewText.textContent = text;
    sendMail.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(text)}`;
    review.showModal();
  });

  review.querySelectorAll('[data-review-close]').forEach((b) => b.addEventListener('click', () => review.close()));

  document.querySelector('[data-copy]')!.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(reviewText.textContent || '');
      btn.textContent = 'Copied';
    } catch {
      const range = document.createRange();
      range.selectNodeContents(reviewText);
      const sel = window.getSelection();
      sel?.removeAllRanges();
      sel?.addRange(range);
      btn.textContent = 'Text selected — press Ctrl/⌘ + C';
    }
    setTimeout(() => (btn.textContent = 'Copy enquiry text'), 2500);
  });
</script>

<style>
  .enquiry {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--s-7);
    align-items: start;
  }

  .enquiry__form {
    grid-column: 1 / span 8;
    display: grid;
    gap: var(--s-8);
  }

  .errors {
    padding: var(--s-5);
    border: 2px solid var(--alert);
    background: #fbf3f1;
  }

  .errors:focus {
    outline: 3px solid var(--alert);
    outline-offset: 2px;
  }

  .errors__title {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--alert);
    margin-bottom: var(--s-3);
  }

  .errors :global(a) {
