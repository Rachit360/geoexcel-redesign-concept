---
import Base from '../layouts/Base.astro';
import { url } from '../lib/paths';
---

<Base title="Page not found — Geo Excel" description="The page you were looking for could not be found.">
  <section class="section wrap nf">
    <p class="eyebrow">Error 404</p>
    <h1>This page has <span class="hl">shipped elsewhere.</span></h1>
    <p class="lead">It may have moved in the redesign.</p>
    <div class="btn-row">
      <a class="btn" href={url('/')}>Home <span class="btn__arrow" aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href={url('/products/')}>Products</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
    min-height: 60vh;
    align-content: center;
  }
</style>
