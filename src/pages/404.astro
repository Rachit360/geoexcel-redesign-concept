---
import Base from '../layouts/Base.astro';
import CategoryIndex from '../components/CategoryIndex.astro';
import { url } from '../lib/paths';
---

<Base title="Page not found" description="The page you were looking for could not be found.">
  <section class="section">
    <div class="wrap nf">
      <p class="label mono">Error 404</p>
      <h1>This page is not on the record.</h1>
      <p class="lead">
        It may have moved in the redesign. Start from the product range below, or go to the <a class="link" href={url('/')}>home page</a>.
      </p>
      <CategoryIndex headingLevel="h2" />
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: var(--s-5);
  }

  .nf h1 {
    max-width: 14em;
  }

  .nf .lead {
    margin-bottom: var(--s-6);
  }
</style>
