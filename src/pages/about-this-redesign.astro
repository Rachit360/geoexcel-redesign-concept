---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { company } from '../data/company';
import { registrations, formatDate } from '../data/registrations';
import { productCount } from '../data/catalogue';
import { url } from '../lib/paths';

const withheld = registrations.filter((r) => !r.publish);

const observations = [
  {
    title: 'The homepage did not say what Geo Excel sells',
    text: '“Facilitating International & Domestic Trade — for your business” could describe any trading company. Products, origin and the buyer it serves were two clicks away.',
  },
  {
    title: 'Product data existed but could not be compared',
    text: `Around ${productCount} products were documented on four long pages built from duplicated templates (the spice page lived at /copy-of-rice). Grades could not be compared side by side.`,
  },
  {
    title: 'Specifications contradicted themselves',
    text: 'Several products gave two values for the same parameter — 1121 Sella listed moisture as both 14% and 13.5% maximum — and HS codes, labelled “HNS Code”, varied in length and accuracy.',
  },
  {
    title: 'The only enquiry route was four fields',
    text: 'First name, last name, email and message. No product, quantity, packing, destination port or Incoterm — so every serious enquiry needed a round of clarifying emails before a price could be given.',
  },
  {
    title: 'Credentials were hidden in image sliders',
    text: 'The legal entity, IEC and APEDA registration appeared only inside certificate images. Two of the documents shown carried validity dates that had already passed.',
  },
];

const decisions = [
  'Only facts published by Geo Excel — on its website or in its certificates — are used. No customers, volumes, facilities, markets or statistics have been added.',
  'Where Geo Excel’s own pages gave two different values for one parameter, the parameter is omitted rather than guessed. Obvious errors, such as a nutmeg shelf life of “14 Yr”, are omitted too.',
  'HS codes are shown at the internationally harmonised 4- or 6-digit level. The 8-digit national lines on the old site were inconsistent and are not reproduced.',
  `Registrations are shown with their dates, and status is computed at build time. ${withheld.map((r) => `${r.issuerShort} (valid until ${formatDate(r.validUntil!)})`).join(' and ')} ${withheld.length === 1 ? 'is' : 'are'} kept out of the public register until a current copy is available.`,
  'Company history is presented as the company’s own account, and the 2023 incorporation date is taken from the registration documents.',
  'Every photograph comes from the current geoexcel.group website. Captions describe only what is shown — a product type — and never suggest a Geo Excel farm, mill or facility.',
];

const features = [
  { title: 'Specification-first catalogue', text: `${productCount} product sheets in a consistent order — origin, key parameters, pack sizes, HS code — with a searchable index and per-category comparison tables.` },
  { title: 'Quote list and structured enquiry', text: 'Buyers add products as they browse, then send quantity, unit and packing per line plus destination, Incoterm and timing in one message. The enquiry is shown for review before it is sent.' },
  { title: 'A register you can check', text: 'Registration numbers, issuers and dates in a table, with links to the issuing authorities and status calculated from the validity date.' },
  { title: 'Group story, kept in proportion', text: 'The farming-to-trading history supports credibility without crowding out the products buyers came for.' },
  { title: 'Old links still work', text: 'Every URL of the old site redirects to its new equivalent, so existing links and bookmarks keep working.' },
];

const needed = [
  'Current FSSAI licence and Council for Leather Exports RCMC.',
  'Confirmation of every specification, and the national HS tariff lines used on invoices.',
  'The logo as a vector file (the mark here is redrawn from the published PNG).',
  'Photography of Geo Excel’s own products, packing and dispatch, to replace illustrative images.',
  'A decision on the leather footwear line, and where enquiries should be routed.',
  'A form back end (for example a serverless function and transactional email) to replace the email hand-off used in this concept.',
];
---

<Base
  title="About this redesign"
  description="Why Geo Excel’s website was redesigned around specifications and structured enquiries: the problem, the observations behind it, and the accuracy rules followed."
>
  <PageIntro
    crumbs={[{ label: 'About this redesign' }]}
    label="Concept notes"
    title="Turning interest into a quotable enquiry."
    lede="A concept redesign of geoexcel.group, produced as a design and development exercise. It is not the official Geo Excel website."
  >
    <p class="small muted">
      Official site: <a class="link" href={company.officialSite} rel="noopener">geoexcel.group</a>
    </p>
  </PageIntro>

  <section class="section" aria-labelledby="problem-title">
    <div class="wrap grid notes">
      <div class="notes__head">
        <p class="label">The problem</p>
        <h2 id="problem-title">International buyers could not qualify Geo Excel, or ask for a precise quote.</h2>
      </div>
      <div class="notes__body flow">
        <p class="lead">
          Geo Excel’s buyers are importers, distributors and food manufacturers deciding whether a new supplier is worth a
          conversation. They look for three things: what exactly is offered, whether the company is legitimate, and how to
          ask for a price without a week of emails.
        </p>
        <p>The old site had most of the raw material — but not in a form a buyer could use.</p>
      </div>
    </div>
  </section>

  <section class="section section--deep section--tight" aria-labelledby="obs-title">
    <div class="wrap">
      <h2 id="obs-title" class="notes__h">What the audit found</h2>
      <ol class="obs" role="list">
        {
          observations.map((o, i) => (
            <li>
              <span class="mono">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{o.title}</h3>
                <p>{o.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="response-title">
    <div class="wrap grid notes">
      <div class="notes__head">
        <p class="label">The response</p>
        <h2 id="response-title">Make the specification the starting point of every enquiry.</h2>
        <p>
          The redesign treats the website as a buying tool: find a product, check it against your requirement, confirm
          the supplier is registered, and send an enquiry that can be quoted without follow-up questions.
        </p>
        <div class="btn-row">
          <a class="btn" href={url('/enquiry/')}>Try the enquiry flow</a>
          <a class="btn btn--secondary" href={url('/products/')}>Product index</a>
        </div>
      </div>
      <dl class="features">
        {
          features.map((f) => (
            <div>
              <dt>{f.title}</dt>
              <dd>{f.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section section--deep" aria-labelledby="rules-title">
    <div class="wrap grid notes">
      <div class="notes__head">
        <p class="label">Accuracy</p>
        <h2 id="rules-title">Nothing invented</h2>
        <p>A supplier’s website is a document buyers rely on. These rules were applied throughout.</p>
      </div>
      <ol class="rules" role="list">
        {decisions.map((d, i) => <li><span class="mono">{String(i + 1).padStart(2, '0')}</span><p>{d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="needed-title">
    <div class="wrap grid notes">
      <div class="notes__head">
        <p class="label">Before launch</p>
        <h2 id="needed-title">What Geo Excel would need to provide</h2>
      </div>
      <ul class="needed" role="list">
        {needed.map((n) => <li>{n}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--deep section--tight" aria-labelledby="build-title">
    <div class="wrap grid notes">
      <div class="notes__head">
        <p class="label">Build</p>
        <h2 id="build-title" class="notes__h">How it is made</h2>
      </div>
      <div class="notes__body flow">
        <p>
          A static site built with Astro: no tracking, no cookies, and no third-party scripts. Images are served as
          AVIF and WebP at the size each layout needs. Fonts — Newsreader, Inter and IBM Plex Mono — are self-hosted.
        </p>
        <p>
          Accessibility is built in: semantic tables for specifications, visible focus, keyboard-operable menus, labelled
          form errors with a summary, and motion that respects reduced-motion settings. The site is marked
          <span class="mono">noindex</span> so that it is never mistaken for the official website in search results.
        </p>
        <p class="small muted">Concept design and development: Rachit Trivedi.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .notes {
    row-gap: var(--s-6);
    align-items: start;
  }

  .notes__head {
    grid-column: 1 / span 5;
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .notes__head .btn-row {
    margin-top: var(--s-3);
  }

  .notes__body {
    grid-column: 7 / span 6;
    --flow: 1.1rem;
  }

  .notes__h {
    font-size: var(--step-h3);
    margin-bottom: var(--s-6);
  }

  .obs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0 var(--gutter);
  }

  .obs li {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding: var(--s-5) 0;
    border-top: 1px solid var(--ink);
  }

  .obs .mono,
  .rules .mono {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .obs h3 {
    font-size: 1.25rem;
  }

  .features {
    grid-column: 7 / span 6;
    border-top: 1px solid var(--ink);
  }

  .features > div {
    padding: var(--s-5) 0;
    border-bottom: 1px solid var(--rule);
  }

  .features dt {
    font-family: var(--font-serif);
    font-size: 1.3125rem;
    color: var(--ink);
    margin-bottom: var(--s-2);
  }

  .rules,
  .needed {
    grid-column: 7 / span 6;
    border-top: 1px solid var(--ink);
  }

  .rules li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--s-3);
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--rule);
  }

  .rules .mono {
    padding-top: 0.2rem;
  }

  .needed li {
    padding: var(--s-4) 0 var(--s-4) 1.5rem;
    border-bottom: 1px solid var(--rule);
    position: relative;
  }

  .needed li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.55rem;
    width: 0.5rem;
    height: 0.5rem;
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }

  @media (max-width: 899px) {
    .notes__head,
    .notes__body,
    .features,
    .rules,
    .needed {
      grid-column: 1 / -1;
    }
  }
</style>
