---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
import { company, heritage, commitments, fullAddress } from '../data/company';
import { registrations, formatDate } from '../data/registrations';
import { url } from '../lib/paths';
import { photo } from '../lib/images';

const verticals = [
  { name: 'Agriculture', text: 'Where the family began: growing and harvesting rice, sugarcane and sesame from the 1980s.' },
  { name: 'Construction', text: 'Cement and steel dealing from the 1990s, then turn-key civil construction from 1993, including developments under the name Anuadi Constructions.' },
  { name: 'Automotive', text: 'Listed by the company among the Group’s verticals.' },
  { name: 'Trading', text: 'Geo Excel: the export of rice, spices, frozen foods, edible oils, ghee and leather footwear presented on this site.' },
];

const reg = (id: string) => registrations.find((r) => r.id === id)!;
const identity = [
  { label: 'Legal name', value: company.legalName },
  { label: 'Incorporated', value: formatDate(company.incorporated), mono: true },
  { label: 'Registered office', value: fullAddress.join(', ') },
  { label: 'Importer-Exporter Code', value: reg('iec').number, mono: true },
  { label: 'APEDA RCMC', value: reg('apeda-rcmc').number, mono: true },
  { label: 'Udyam registration', value: reg('udyam').number, mono: true },
];
---

<Base
  title="The Group"
  description="Geo Excel — short for Geographic Excellence — is the export business of a Bengaluru family group with roots in farming since the 1980s, and later in construction and trading."
>
  <PageIntro
    crumbs={[{ label: 'The Group' }]}
    label="The Group"
    title="From the farm to the export desk."
    lede="Geo Excel — short for Geographic Excellence — was named in 2023. The family behind it has worked in agriculture, construction and trade since the 1980s."
  />

  <section class="band-full" aria-label="Photograph">
    <figure class="figure">
      <div class="band-full__img">
        <Picture src={photo('band-spice-bowls')} formats={['avif', 'webp']} widths={[800, 1280, 1920]} sizes="100vw" alt="Bowls of whole and ground spices arranged in rows" />
      </div>
      <figcaption class="wrap"><span class="mono">Fig. 01</span> Whole and ground spices.</figcaption>
    </figure>
  </section>

  <section class="section" aria-labelledby="timeline-title">
    <div class="wrap grid timeline">
      <div class="timeline__intro">
        <p class="label">Timeline</p>
        <h2 id="timeline-title">Four decades, as the company tells it</h2>
        <p>
          The milestones below are those Geo Excel publishes about its history. The export company itself was incorporated
          on {formatDate(company.incorporated)}.
        </p>
        <figure class="figure">
          <div class="ratio ratio--3x2">
            <Picture src={photo('sesame-spoons')} formats={['avif', 'webp']} widths={[480, 800]} sizes="(min-width: 900px) 34vw, 100vw" alt="White and black sesame seeds in wooden spoons" />
          </div>
          <figcaption><span class="mono">Fig. 02</span> Sesame, one of the family’s first crops.</figcaption>
        </figure>
      </div>
      <ol class="ledger" role="list">
        {
          heritage.map((h) => (
            <li data-reveal>
              <span class="numeral ledger__year">{h.year}</span>
              <div>
                <h3>{h.title}</h3>
                <p>{h.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--deep" aria-labelledby="verticals-title">
    <div class="wrap">
      <div class="heading heading--split">
        <div class="flow" style="--flow: 1rem">
          <p class="label">Verticals</p>
          <h2 id="verticals-title">One group, four lines of business</h2>
        </div>
        <p class="lead">Trading — Geo Excel — is the business this website is for.</p>
      </div>
      <ol class="verticals" role="list">
        {
          verticals.map((v, i) => (
            <li class:list={{ 'is-current': v.name === 'Trading' }}>
              <span class="mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{v.name}</h3>
              <p>{v.text}</p>
              {v.name === 'Trading' && <a class="link link--arrow" href={url('/products/')}>The product range</a>}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="identity-title">
    <div class="wrap grid identity">
      <div class="identity__head">
        <p class="label">Company record</p>
        <h2 id="identity-title">Who you are dealing with</h2>
        <p>Taken from the company’s registration documents.</p>
        <p><a class="link link--arrow" href={url('/quality/')}>All registrations</a></p>
      </div>
      <dl class="identity__list">
        {
          identity.map((row) => (
            <div>
              <dt>{row.label}</dt>
              <dd class:list={{ mono: row.mono }}>{row.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section section--deep" id="commitments" aria-labelledby="commitments-title">
    <div class="wrap grid commit">
      <div class="commit__head">
        <p class="label">Sustainability</p>
        <h2 id="commitments-title">Stated commitments</h2>
        <p>
          In 2019 the Group set out a focus on the United Nations Sustainable Development Goals and on CSR activity. These
          are the principles it lists.
        </p>
      </div>
      <ul class="commit__list" role="list">
        {commitments.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <EnquiryBand />
</Base>

<style>
  .band-full__img {
    height: clamp(14rem, 30vw, 28rem);
    overflow: hidden;
    background: var(--paper-sunk);
  }

  .band-full__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .timeline,
  .identity,
  .commit {
    row-gap: var(--s-7);
    align-items: start;
  }

  .timeline__intro {
    grid-column: 1 / span 5;
    display: grid;
    gap: var(--s-5);
    position: sticky;
    top: calc(var(--header-h) + var(--s-5));
  }

  .timeline__intro figure {
    margin-top: var(--s-4);
  }

  .ledger {
    grid-column: 7 / span 6;
    border-top: 1px solid var(--ink);
  }

  .ledger li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--s-5);
    padding: var(--s-7) 0;
    border-bottom: 1px solid var(--rule);
  }

  .ledger__year {
    font-size: clamp(1.75rem, 1.4rem + 1vw, 2.5rem);
    line-height: 1;
  }

  .ledger h3 {
    margin-bottom: var(--s-2);
  }

  .verticals {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gutter);
  }

  .verticals li {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
  }

  .verticals li.is-current {
    border-top: 2px solid var(--ink);
  }

  .verticals .mono {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .identity__head {
    grid-column: 1 / span 4;
    display: grid;
    gap: var(--s-4);
  }

  .identity__list {
    grid-column: 6 / span 7;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .identity__list > div {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: var(--s-4);
    padding: 0.9rem 0;
  }

  .identity__list > div + div {
    border-top: 1px solid var(--rule);
  }

  .identity__list dt {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .identity__list dd {
    color: var(--ink);
  }

  .identity__list dd.mono {
    font-size: 0.9375rem;
  }

  .commit__head {
    grid-column: 1 / span 5;
    display: grid;
    gap: var(--s-4);
  }

  .commit__list {
    grid-column: 7 / span 6;
    border-top: 1px solid var(--ink);
  }

  .commit__list li {
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.35;
    color: var(--ink);
  }

  @media (max-width: 899px) {
    .timeline__intro,
    .ledger,
    .identity__head,
    .identity__list,
    .commit__head,
    .commit__list {
      grid-column: 1 / -1;
    }
    .timeline__intro {
      position: static;
    }
    .verticals {
      grid-template-columns: 1fr 1fr;
      row-gap: var(--s-6);
    }
  }

  @media (max-width: 539px) {
    .verticals {
      grid-template-columns: 1fr;
    }
    .ledger li,
    .identity__list > div {
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }
  }
</style>
