---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CategoryIndex from '../components/CategoryIndex.astro';
import SpecSheet from '../components/SpecSheet.astro';
import AddToQuote from '../components/AddToQuote.astro';
import ShippingMark from '../components/ShippingMark.astro';
import Register from '../components/Register.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
import { categories, findProduct, productCount } from '../data/catalogue';
import { heritage } from '../data/company';
import { publicRegister } from '../data/registrations';
import { url, productUrl, categoryUrl } from '../lib/paths';
import { photo } from '../lib/images';

const featured = findProduct('rice', '1121-basmati-steam')!;
const rice = categories.find((c) => c.slug === 'rice')!;
const spec = (label: string) => featured.specs.find((s) => s.label === label)!.value;

const figures = [
  { value: spec('Average grain length').replace(' mm', ''), unit: 'mm', label: 'Average grain length' },
  { value: spec('Broken').replace('Under ', '<'), unit: '', label: 'Broken grains' },
  { value: spec('Moisture'), unit: '', label: 'Moisture' },
];

const steps = [
  { title: 'Build a quote list', text: 'Add products from their sheets as you browse. The list stays in your browser until you send it.' },
  { title: 'Add the details', text: 'Quantity, unit and packing for each line; destination port, Incoterm and timing once.' },
  { title: 'Review and send', text: 'See the whole enquiry as one document before it goes. Nothing is sent without you.' },
  { title: 'Receive a quotation', text: 'Geo Excel replies with the grade, packing, terms and price it can offer for each line.' },
];
---

<Base
  title="Geo Excel — Indian rice, spices, frozen foods and edible oils for export"
  bareTitle
  description="Geo Excel is a Bengaluru merchant exporter of rice, whole spices, IQF frozen foods, edible oils and ghee. Product sheets with origin, grade, packing and HS codes, and a structured quotation request."
>
  <!-- Hero ---------------------------------------------------------------- -->
  <section class="hero jute">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="label">Merchant exporter · Bengaluru, India</p>
        <h1 class="hero__title">From India, <span>to your spec.</span></h1>
        <p class="lead">
          Rice, whole spices, frozen foods and edible oils — every product listed with its grade, origin, packing and
          HS code, so your enquiry starts from a specification.
        </p>
        <div class="btn-row">
          <a class="btn btn--red" href={url('/enquiry/')}>Request a quote</a>
          <a class="btn btn--secondary" href={url('/products/')}>Browse {productCount} products</a>
        </div>
        <ul class="hero__creds" role="list" aria-label="Registrations">
          {publicRegister.map((r) => <li><span>{r.issuerShort}</span> {r.id === 'iec' ? r.number : r.id === 'udyam' ? 'Udyam registered' : 'RCMC'}</li>)}
        </ul>
      </div>

      <div class="hero__visual">
        <figure class="hero__figure">
          <div class="ratio ratio--4x5">
            <Picture
              src={photo('hero-rice-spoon')}
              formats={['avif', 'webp']}
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 900px) 40vw, 100vw"
              alt="Long-grain white rice heaped around a wooden spoon"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </figure>
        <ShippingMark
          class="hero__mark"
          name={featured.name}
          lines={[`${featured.origin!.split(',')[0]} · ${spec('Average grain length')} grain`, `Packs ${featured.packing!.sizes}`, `HS ${featured.hs}`]}
        />
      </div>
    </div>
  </section>

  <!-- Category board ------------------------------------------------------ -->
  <section class="section section--ink on-ink" aria-labelledby="range-title">
    <div class="wrap">
      <div class="heading heading--split">
        <div class="flow" style="--flow: 1rem">
          <p class="label">The range</p>
          <h2 id="range-title">Four categories. {productCount} product sheets.</h2>
        </div>
        <p class="lead">
          Each category carries the colour of a stroke in the Geo Excel mark, from the menu to the quote list.
        </p>
      </div>
      <CategoryIndex />
    </div>
  </section>

  <!-- Specification as the hero ------------------------------------------- -->
  <section class="section spec" aria-labelledby="spec-title">
    <div class="wrap">
      <div class="spec__intro">
        <p class="label">On the sheet</p>
        <h2 id="spec-title">A buyer’s first question is never the price.</h2>
        <p class="lead">
          It is grade, origin and packing. Every product has a sheet that answers them in the same order — here is
          one.
        </p>
      </div>

      <div class="spec__grid">
        <div class="figures-wrap">
        <dl class="figures" aria-label={`${featured.name}: key parameters`}>
          {
            figures.map((f, i) => (
              <div class="figures__row" data-reveal style={`transition-delay:${i * 80}ms`}>
                <dt>{f.label}</dt>
                <dd>
                  <span class="numeral">{f.value}</span>
                  {f.unit && <span class="figures__unit">{f.unit}</span>}
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="figures__caption">{featured.name} · {featured.origin}</p>
        </div>

        <div class="spec__sheet">
          <SpecSheet product={featured} category={rice} headingLevel="h3" />
          <div class="btn-row">
            <AddToQuote product={featured} category={rice} variant="primary" />
            <a class="btn btn--secondary" href={productUrl('rice', featured.slug)}>Full sheet</a>
          </div>
          <p><a class="link link--arrow" href={categoryUrl('rice')}>Compare all {rice.products.length} rice grades</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- How an enquiry works ------------------------------------------------- -->
  <section class="section jute manifest" aria-labelledby="how-title">
    <div class="wrap">
      <div class="heading heading--split">
        <div class="flow" style="--flow: 1rem">
          <p class="label">How it works</p>
          <h2 id="how-title">One enquiry. Every line on it.</h2>
        </div>
        <p class="lead">Instead of a week of emails about what is available, one structured request that can be quoted.</p>
      </div>

      <div class="manifest__grid">
        <ol class="steps" role="list">
          {
            steps.map((s, i) => (
              <li class="steps__item" data-reveal>
                <span class="steps__num numeral" aria-hidden="true">{i + 1}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <figure class="doc" aria-labelledby="doc-caption">
          <div class="doc__head">
            <span>Quotation request</span>
            <span class="num">Example</span>
          </div>
          <div class="doc__body">
            <p class="doc__section">Products</p>
            <ol class="doc__lines" role="list">
              <li><span class="num">01</span><span>1121 Basmati Steam <em>Rice</em></span><span class="num">25 t · 25 kg PP</span></li>
              <li><span class="num">02</span><span>Green cardamom <em>Spices</em></span><span class="num">500 kg · 1 kg</span></li>
              <li><span class="num">03</span><span>Sweet corn <em>Frozen</em></span><span class="num">1 × 40 ft</span></li>
            </ol>
            <p class="doc__section">Shipment</p>
            <p class="doc__kv"><span>Destination</span><span class="num">Jebel Ali, UAE</span></p>
            <p class="doc__kv"><span>Incoterm</span><span class="num">CIF</span></p>
          </div>
          <figcaption id="doc-caption" class="doc__foot">An example of what the enquiry form produces. Quantities are illustrative.</figcaption>
        </figure>
      </div>
      <p class="manifest__cta"><a class="btn" href={url('/enquiry/')}>Start your quote list</a></p>
    </div>
  </section>

  <!-- Register ------------------------------------------------------------- -->
  <section class="section" aria-labelledby="register-title">
    <div class="wrap">
      <div class="heading heading--split">
        <div class="flow" style="--flow: 1rem">
          <p class="label">Registrations</p>
          <h2 id="register-title">Numbers you can check.</h2>
        </div>
        <p class="lead">Status is calculated from each document’s validity date — nothing is shown as current after it expires.</p>
      </div>
      <Register />
      <p class="register-note"><a class="link link--arrow" href={url('/quality/')}>Quality and registrations</a></p>
    </div>
  </section>

  <!-- Heritage ------------------------------------------------------------- -->
  <section class="heritage section--ink on-ink" aria-labelledby="heritage-title">
    <div class="heritage__img">
      <Picture
        src={photo('band-spice-bowls')}
        formats={['avif', 'webp']}
        widths={[800, 1280, 1920]}
        sizes="100vw"
        alt="Bowls of whole and ground spices arranged in rows, seen from above"
      />
    </div>
    <div class="wrap heritage__body">
      <div class="heritage__intro">
        <p class="label">The Group</p>
        <h2 id="heritage-title">Farmers first. Exporters since 2023.</h2>
        <p class="lead">
          Geo Excel — short for Geographic Excellence — is the export business of a Bengaluru family that began by
          growing rice, sugarcane and sesame.
        </p>
        <p><a class="link link--arrow" href={url('/group/')}>The Group</a></p>
      </div>
      <ol class="years" role="list">
        {
          heritage.map((h) => (
            <li data-reveal>
              <span class="years__year numeral">{h.year}</span>
              <h3>{h.title}</h3>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <EnquiryBand />
</Base>

<style>
  /* Hero ---------------------------------------------------------------- */
  .hero {
    border-bottom: 3px solid var(--ink);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--s-7);
    padding-block: var(--s-7) var(--s-8);
    align-items: end;
  }

  .hero__text {
    grid-column: 1 / span 7;
    display: grid;
    gap: var(--s-5);
    align-self: start;
    padding-top: var(--s-4);
  }

  .hero__title {
    font-size: var(--step-poster);
    line-height: 0.8;
    letter-spacing: 0;
  }

  .hero__title span {
    display: block;
    color: var(--red);
  }

  .hero__text .lead {
    margin-top: var(--s-3);
  }

  .hero__creds {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    padding-top: var(--s-4);
    border-top: 2px solid var(--ink);
    font: 650 1rem/1.3 var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .hero__creds span {
    font-weight: 850;
  }

  .hero__visual {
    grid-column: 8 / span 5;
    position: relative;
    padding-bottom: var(--s-6);
  }

  .hero__figure {
    border: 3px solid var(--ink);
  }

  .hero__visual :global(.hero__mark) {
    position: absolute;
    left: calc(var(--s-8) * -1.4);
    bottom: 0;
    width: min(23rem, 92%);
  }

  /* Spec ---------------------------------------------------------------- */
  .spec__intro {
    display: grid;
    gap: var(--s-4);
    max-width: 52rem;
    margin-bottom: var(--s-8);
  }

  .spec__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--s-7);
    align-items: start;
  }

  .figures-wrap {
    grid-column: 1 / span 6;
  }

  .figures {
    border-top: 3px solid var(--ink);
  }

  .figures__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--s-4);
    padding: var(--s-4) 0 var(--s-3);
    border-bottom: 3px solid var(--ink);
  }

  .figures__row dt {
    padding-bottom: 0.6rem;
    font: 800 1.125rem/1.1 var(--font-display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .figures__row dd {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .figures__row .numeral {
    font-size: clamp(4.5rem, 2.6rem + 6.4vw, 9.5rem);
    color: var(--red);
  }

  .figures__unit {
    font: 850 clamp(1.5rem, 1.1rem + 1.4vw, 2.5rem) / 1 var(--font-stencil);
    text-transform: uppercase;
    color: var(--ink);
  }

  .figures__caption {
    padding-top: var(--s-3);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .spec__sheet {
    grid-column: 8 / span 5;
    display: grid;
    gap: var(--s-5);
  }

  /* Manifest ------------------------------------------------------------ */
  .manifest {
    border-top: 3px solid var(--ink);
    border-bottom: 3px solid var(--ink);
  }

  .manifest__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--s-7);
    align-items: start;
  }

  .steps {
    grid-column: 1 / span 6;
    display: grid;
    gap: 0;
    border-top: 3px solid var(--ink);
  }

  .steps__item {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--s-4);
    align-items: start;
    padding: var(--s-5) 0;
    border-bottom: 1px solid rgba(22, 32, 42, 0.35);
  }

  .steps__num {
    font-size: 5.5rem;
    color: var(--ink);
  }

  .steps__item h3 {
    margin: 0.4rem 0 var(--s-2);
  }

  .steps__item p {
    max-width: 30rem;
  }

  .doc {
    grid-column: 8 / span 5;
    background: var(--bone);
    border: 3px solid var(--ink);
    box-shadow: var(--mark-shadow);
  }

  .doc__head {
    display: flex;
    justify-content: space-between;
    padding: 0.7rem 1rem;
    background: var(--ink);
    color: var(--bone);
    font: 850 1.25rem/1 var(--font-stencil);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .doc__head .num {
    color: var(--mark-orange);
    font-size: 1rem;
    letter-spacing: 0.12em;
  }

  .doc__body {
    padding: var(--s-4) 1rem var(--s-5);
  }

  .doc__section {
    margin-top: var(--s-4);
    padding-bottom: 0.35rem;
    border-bottom: 2px solid var(--ink);
    font: 800 0.9375rem/1 var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
  }

  .doc__section:first-child {
    margin-top: 0;
  }

  .doc__lines li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    gap: var(--s-3);
    align-items: baseline;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .doc__lines em {
    display: block;
    font-style: normal;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .doc__lines .num,
  .doc__kv .num {
    font-size: 1.0625rem;
    color: var(--ink);
  }

  .doc__kv {
    display: flex;
    justify-content: space-between;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .doc__foot {
    padding: 0.7rem 1rem;
    border-top: 2px solid var(--ink);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .manifest__cta {
    margin-top: var(--s-7);
  }

  /* Register ------------------------------------------------------------ */
  .register-note {
    margin-top: var(--s-5);
  }

  /* Heritage ------------------------------------------------------------ */
  .heritage__img {
    height: clamp(14rem, 34vw, 30rem);
    overflow: hidden;
    border-bottom: 6px solid var(--mark-orange);
  }

  .heritage__img :global(picture) {
    display: block;
    height: 100%;
  }

  .heritage__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    filter: saturate(0.9);
  }

  .heritage__body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--s-7);
    padding-block: var(--s-8) var(--section);
  }

  .heritage__intro {
    grid-column: 1 / span 5;
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .years {
    grid-column: 7 / span 6;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--gutter);
  }

  .years li {
    padding: var(--s-4) 0 var(--s-5);
    border-top: 3px solid var(--bone);
  }

  .years__year {
    display: block;
    font-size: clamp(3rem, 2.2rem + 2.6vw, 5rem);
    color: var(--mark-orange);
  }

  .years h3 {
    margin-top: var(--s-2);
    font-size: 1.375rem;
  }

  .years li:last-child {
    grid-column: 1 / -1;
  }

  .years li:last-child .years__year {
    color: var(--bone);
  }

  /* Responsive ---------------------------------------------------------- */
  @media (max-width: 1023px) {
    .hero__text,
    .hero__visual,
    .figures-wrap,
    .spec__sheet,
    .steps,
    .doc,
    .heritage__intro,
    .years {
      grid-column: 1 / -1;
    }
    .hero__visual {
      max-width: 34rem;
      padding-left: var(--s-6);
    }
    .hero__visual :global(.hero__mark) {
      left: 0;
    }
    .doc {
      max-width: 34rem;
    }
  }

  @media (max-width: 539px) {
    .hero__grid {
      padding-top: var(--s-6);
    }
    .hero__visual {
      padding-left: var(--s-4);
      padding-bottom: var(--s-8);
    }
    .hero__visual :global(.hero__mark) {
      width: 92%;
    }
    .steps__item {
      grid-template-columns: 3.5rem minmax(0, 1fr);
    }
    .steps__num {
      font-size: 4rem;
    }
    .figures__row {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .figures__row dt {
      padding-bottom: 0;
    }
  }
</style>
